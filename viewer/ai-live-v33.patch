diff --git a/src/client/kiEinblendung.ts b/src/client/kiEinblendung.ts
new file mode 100644
index 000000000..67a7a30be
--- /dev/null
+++ b/src/client/kiEinblendung.ts
@@ -0,0 +1,208 @@
+/**
+ * Der KI-Teil des Clients, Seite der Hauptseite.
+ *
+ * Was dieses Fenster tut, steht allein in der Adresse (`src/core/aiKonfig.ts`). Ohne
+ * Parameter ist alles aus — dann ist das hier der ganz normale Client, in dem der Nutzer
+ * selbst spielt. Die Oberfläche bleibt immer die normale: der Nutzer kann jederzeit
+ * selbst klicken, bauen, angreifen; er und das Modell steuern dasselbe Volk.
+ *
+ * Portiert aus `aiFenster.ts` (Viewer-Client, 88cc95d8). Weggefallen ist alles, was zum
+ * Vierfenster-Viewer gehörte: iframe-Steuerung über postMessage, Zuschauer-Ansicht,
+ * Relay. Geblieben sind die Einblendung unten links, der Autostart fürs Einzelspiel und
+ * die Anbindung der öffentlichen Lobby.
+ */
+import { aiKonfig } from "../core/aiKonfig";
+import {
+  oeffentlichAnmelden,
+  oeffentlichAnzeige,
+  oeffentlichSpiel,
+  oeffentlichStand,
+  protokollText,
+} from "./oeffentlicheLobby";
+
+export interface KiMesswerte {
+  tick: number;
+  gebiet: number; // Anteil an allen Landkacheln
+  kacheln: number;
+  truppen: number;
+  gold: number;
+  platz: number;
+  lebende: number;
+  handlungen: number;
+  handlungen_je_1000: number;
+  p_handeln: number | null;
+  letzte_aktion: string | null;
+  ckpt_step: number | null;
+}
+
+const g = globalThis as any;
+
+/** Einzelspiel starten, mit den Vorgaben aus der Adresse (nur `?auto=1`). */
+function starteEinzelspiel(): void {
+  const k = aiKonfig();
+  const versuch = () => {
+    const m: any = document.querySelector("single-player-modal");
+    if (
+      !m ||
+      typeof m.startGame !== "function" ||
+      !document.querySelector("username-input")
+    ) {
+      setTimeout(versuch, 400);
+      return;
+    }
+    try {
+      if (k.karte) {
+        m.useRandomMap = false;
+        m.selectedMap = k.karte;
+      } else if (typeof m.handleSelectRandomMap === "function") {
+        m.handleSelectRandomMap();
+      }
+      if (k.groesse) m.compactMap = k.groesse === "Compact";
+      if (k.bots !== null) m.bots = k.bots;
+      m.requestUpdate?.();
+    } catch (e) {
+      console.warn("[ki] Modal-Vorgaben:", e);
+    }
+    Promise.resolve(m.startGame()).catch((e: any) =>
+      console.error("[ki] Start:", e),
+    );
+  };
+  setTimeout(versuch, 1200);
+}
+
+/**
+ * Kleine Einblendung unten links, wegklappbar.
+ *
+ * Die normale Oberfläche läuft weiter, und der Nutzer greift selbst ein — die Kennzahlen
+ * dürfen ihm darum nichts verdecken. Sie stehen in einer schmalen Leiste am Rand, die
+ * sich auf eine Lasche zusammenklappen lässt; der Zustand bleibt gespeichert.
+ */
+const KLAPP_SCHLUESSEL = "ki-einblendung-offen";
+let werteZeile: HTMLElement | null = null;
+
+function baueEinblendung(offenVorgabe: boolean): void {
+  if (document.getElementById("ki-einblendung")) return;
+  const kasten = document.createElement("div");
+  kasten.id = "ki-einblendung";
+  kasten.style.cssText =
+    "position:fixed;left:8px;bottom:8px;z-index:2147483000;max-width:min(46vw,560px);" +
+    "background:rgba(12,15,20,.88);border:1px solid #3a4252;border-radius:10px;" +
+    "color:#e7e9ee;font:12px/1.4 system-ui,sans-serif;padding:5px 8px;" +
+    "box-shadow:0 2px 10px rgba(0,0,0,.45)";
+
+  const kopf = document.createElement("div");
+  kopf.style.cssText = "display:flex;gap:8px;align-items:center;cursor:pointer";
+  const lasche = document.createElement("span");
+  lasche.textContent = "KI";
+  lasche.style.cssText = "font-weight:700;color:#63d19e";
+  const pfeil = document.createElement("span");
+  pfeil.style.color = "#8b93a3";
+  kopf.append(lasche, pfeil);
+
+  const koerper = document.createElement("div");
+  werteZeile = document.createElement("div");
+  werteZeile.style.cssText =
+    "display:flex;gap:10px;flex-wrap:wrap;color:#8b93a3;font-variant-numeric:tabular-nums";
+  werteZeile.textContent = "wartet auf den Start …";
+  koerper.append(werteZeile);
+
+  const gespeichert = localStorage.getItem(KLAPP_SCHLUESSEL);
+  let offen = gespeichert === null ? offenVorgabe : gespeichert === "1";
+  const zeichne = () => {
+    koerper.style.display = offen ? "block" : "none";
+    pfeil.textContent = offen ? "▾ zuklappen" : "▸ aufklappen";
+  };
+  kopf.onclick = () => {
+    offen = !offen;
+    localStorage.setItem(KLAPP_SCHLUESSEL, offen ? "1" : "0");
+    zeichne();
+  };
+  zeichne();
+
+  kasten.append(kopf, koerper);
+  document.body.appendChild(kasten);
+
+  // Die öffentliche Partie hängt ihre Uhr und den Verlassen-Knopf hier ein. Fällt
+  // oeffentlicheLobby.ts weg, liefert der Aufruf null und die Einblendung bleibt leer.
+  const zusatz = oeffentlichAnzeige();
+  if (zusatz) koerper.append(zusatz);
+}
+
+/** Ein Feld "Beschriftung Wert" als reiner Text — nie innerHTML, die Werte sind fremd. */
+function feld(beschriftung: string, wert: string): HTMLElement {
+  const span = document.createElement("span");
+  span.append(document.createTextNode(beschriftung + " "));
+  const b = document.createElement("b");
+  b.style.color = "#e7e9ee";
+  b.textContent = wert;
+  span.append(b);
+  return span;
+}
+
+function zeigeWerte(w: KiMesswerte): void {
+  if (!werteZeile) return;
+  const z = (x: unknown, n = 0) => {
+    const v = Number(x);
+    return Number.isFinite(v) ? v.toFixed(n) : "—";
+  };
+  werteZeile.replaceChildren(
+    feld("Tick", z(w.tick)),
+    feld("Gebiet", z(Number(w.gebiet) * 100, 2) + " %"),
+    feld("Platz", z(w.platz) + "/" + z(w.lebende)),
+    feld("Truppen", z(Number(w.truppen) / 1000) + "k"),
+    feld("Handl./1000", z(w.handlungen_je_1000, 1)),
+    feld("P(handeln)", w.p_handeln === null ? "—" : z(w.p_handeln, 3)),
+    feld("Aktion", String(w.letzte_aktion ?? "—").slice(0, 40)),
+  );
+}
+
+/** Kennzahlen aus dem Worker in die Einblendung (und ins Protokoll der Partie). */
+function meldeMesswerte(oeffentlich: boolean): void {
+  let letzte = 0;
+  g.__KI_MESSWERTE__ = (w: KiMesswerte) => {
+    const jetzt = Date.now();
+    if (jetzt - letzte < 500) return; // niemand braucht 10 Hz
+    letzte = jetzt;
+    zeigeWerte(w);
+    if (oeffentlich) oeffentlichStand(w);
+  };
+}
+
+export function installiereKi(): void {
+  const k = aiKonfig();
+  g.__AI_KONFIG__ = k;
+  if (k.tempoMs > 0) g.__KI_TEMPO_MS__ = k.tempoMs;
+  meldeMesswerte(k.oeffentlich);
+
+  // Öffentliche Lobby (src/client/oeffentlicheLobby.ts). Der Nutzer klickt sein Spiel
+  // im normalen Startbildschirm selbst an und setzt seinen Startpunkt selbst; das
+  // Modell übernimmt nach der Startphase (spawnSelbst=false, siehe Worker.worker.ts).
+  let oeffentlichLaeuft = false;
+  if (k.oeffentlich) {
+    const grund = oeffentlichAnmelden();
+    if (grund) {
+      console.warn("[ki] öffentliche Partie abgelehnt:", grund);
+      alert("Öffentliche Partie nicht möglich:\n\n" + grund);
+    } else {
+      oeffentlichLaeuft = true;
+      // Spiel-ID fürs Protokoll, sobald der Nutzer eine Lobby betritt.
+      document.addEventListener("join-lobby", (ev: any) => {
+        const id = ev?.detail?.gameID;
+        if (typeof id === "string") oeffentlichSpiel(id);
+      });
+      // Zum Vorzeigen: in der Konsole `kiProtokoll()` aufrufen.
+      g.kiProtokoll = () => {
+        const t = protokollText();
+        console.log(t);
+        return t;
+      };
+      console.info(
+        "[ki] öffentliche Partie freigegeben. Protokoll: kiProtokoll()",
+      );
+    }
+  }
+
+  if (k.ki || k.oeffentlich) baueEinblendung(oeffentlichLaeuft);
+  if (k.oeffentlich && !oeffentlichLaeuft) return;
+  if (k.auto) starteEinzelspiel();
+}
diff --git a/src/client/oeffentlicheLobby.ts b/src/client/oeffentlicheLobby.ts
new file mode 100644
index 000000000..05a281712
--- /dev/null
+++ b/src/client/oeffentlicheLobby.ts
@@ -0,0 +1,402 @@
+/**
+ * Öffentliche Lobbys — eingeschaltet, mit Protokoll.
+ *
+ * Die Entwickler von OpenFront haben zugestimmt (siehe `ERLAUBNIS`). Die Kennzeichnung
+ * macht seitdem der Server: die IP, von der aus gespielt wird, ist serverseitig als Bot
+ * markiert, und für alle Mitspieler steht im Namen ein Roboter-Emoji und „AI" statt
+ * „player". Dieses Modul kennzeichnet darum nichts mehr selbst — eine zweite,
+ * clientseitige Kennzeichnung wäre nur eine, die man abschalten kann, und würde über die
+ * echte hinwegtäuschen.
+ *
+ * Was hier bleibt:
+ *   · genau `GRENZE_GLEICHZEITIG` Instanz gleichzeitig — so weit reicht die Erlaubnis.
+ *     Gesperrt wird über Tabs hinweg, und eingebettete Fenster sind ausgeschlossen:
+ *     wer in einem iframe läuft, kommt hier nicht durch (`window.parent !== window`).
+ *   · ein Protokoll je Partie (Beginn, Spiel-ID, Dauer, Ergebnis, wie beendet);
+ *   · eine Leiste im Bild mit der Spieldauer und einem Knopf zum Verlassen. Der Nutzer
+ *     steigt nach etwa fünf Minuten selbst aus, damit er niemandem den Spass verdirbt;
+ *     die Leiste nimmt ihm das Rechnen ab.
+ *
+ * Was hier bewusst NICHT steht:
+ *   · Keine Zeitgrenze mehr. Ein Bot, der mitten in der Partie abbricht, hinterlässt ein
+ *     totes Volk, das die Nachbarn gratis einsammeln — das stört mehr als einer, der zu
+ *     Ende spielt. Die alte 5-Minuten-Grenze war als Rücksicht gedacht und war das
+ *     Gegenteil davon.
+ *   · Keine Verschleierung der Herkunft, in keiner Form: kein VPN, kein Exit-Node, kein
+ *     Proxy, keine wechselnden Namen. Gespielt wird von arch aus, und genau diese IP ist
+ *     die markierte. Verschleierung würde die Erlaubnis aufheben, auf der das hier steht.
+ *
+ * Ablauf: Der Nutzer sieht den normalen Startbildschirm, klickt ein öffentliches Spiel an
+ * und setzt seinen Startpunkt selbst. Ab dem Ende der Startphase spielt das Modell
+ * (`spawnSelbst = false` in `src/core/aiKonfig.ts`, ausgewertet in `Worker.worker.ts`).
+ */
+
+/** DER SCHALTER. */
+export const OEFFENTLICHE_LOBBYS_AN = true;
+
+/** Worauf der Schalter sich stützt. Ohne `erteilt` passiert nichts. */
+export const ERLAUBNIS = {
+  erteilt: true,
+  von: "Entwickler von OpenFront (openfrontio)",
+  am: "2026-09-12",
+  fundstelle:
+    "Anfrage des Nutzers nach Bot-Kennzeichnung bzw. markierten Spielen; " +
+    "zugesagt wurde ein serverseitiger Bot-Tag auf der IP, von der aus gespielt wird. " +
+    "Zweite Anfrage im Wortlaut: „Can you confirm in writing that I may build my " +
+    "modified client with the deployed commit hash so it passes the version check, " +
+    "while running the bot from my tagged IP?“ — Antwort des Entwicklers: „ye sure“. " +
+    "Bildschirmfoto liegt beim Nutzer.",
+  art:
+    "Serverseitig: die spielende IP ist als Bot markiert. Mitspieler sehen ein " +
+    "Roboter-Emoji im Namen und „AI“ statt „player“. Die Kennzeichnung kommt vom " +
+    "Server, nicht von diesem Client.",
+  build:
+    "Das Bundle trägt die ausgelieferte Kennung (GIT_COMMIT = der Commit, der auf " +
+    "openfront.io in BOOTSTRAP_CONFIG.gitCommit steht), damit die Versionsprüfung " +
+    "des Spielservers durchgeht. Der Quelltext ist genau dieser Commit plus dem " +
+    "KI-Teil; an der Simulation ist nichts geändert. Ausdrücklich erlaubt, siehe oben.",
+  /**
+   * Die Bot-Kennzeichnung auf der IP gilt nur bis hierhin. Danach wäre eine
+   * öffentliche Partie nicht mehr gekennzeichnet — also keine mehr.
+   * Lokale Zeit, wie der Nutzer sie liest.
+   */
+  laeuftAbAm: "2026-09-13T12:00:00",
+};
+
+/** Zeitpunkt, ab dem der öffentliche Weg den Dienst verweigert. */
+export function erlaubnisEnde(): Date {
+  return new Date(ERLAUBNIS.laeuftAbAm);
+}
+
+/** Ist die Erlaubnis jetzt noch gültig? */
+export function erlaubnisGueltig(jetzt: Date = new Date()): boolean {
+  return jetzt.getTime() < erlaubnisEnde().getTime();
+}
+
+function abgelaufenText(): string {
+  return (
+    "Die Bot-Kennzeichnung der IP gilt nur bis " +
+    erlaubnisEnde().toLocaleString("de-CH") +
+    ". Sie ist abgelaufen: ohne Kennzeichnung wäre eine öffentliche Partie ein " +
+    "unmarkierter Bot unter Menschen. Erst wieder, wenn der Entwickler verlängert " +
+    "(dann ERLAUBNIS.laeuftAbAm in src/client/oeffentlicheLobby.ts nachziehen)."
+  );
+}
+
+export const GRENZE_GLEICHZEITIG = 1;
+
+const PROTOKOLL_SCHLUESSEL = "openfront-ki-oeffentlich-protokoll";
+const SPERRE_SCHLUESSEL = "openfront-ki-oeffentlich-sperre";
+const SPERRE_FRISCH_MS = 15000; // älter = die Instanz ist weg, die Sperre verfällt
+const SPERRE_TAKT_MS = 5000;
+
+export interface ProtokollEintrag {
+  begonnen: string;
+  beendet: string | null;
+  spiel_id: string | null;
+  sekunden: number | null;
+  ergebnis: string | null;
+  grund: string | null;
+}
+
+export function oeffentlichesProtokoll(): ProtokollEintrag[] {
+  try {
+    const roh = JSON.parse(speicher()?.getItem(PROTOKOLL_SCHLUESSEL) || "[]");
+    return Array.isArray(roh) ? roh : [];
+  } catch {
+    return [];
+  }
+}
+
+function schreibeProtokoll(eintraege: ProtokollEintrag[]): void {
+  try {
+    speicher()?.setItem(
+      PROTOKOLL_SCHLUESSEL,
+      JSON.stringify(eintraege.slice(-500)),
+    );
+  } catch {
+    /* ohne Speicher kein Protokoll — und dann auch keine Partie, siehe anmelden() */
+  }
+}
+
+/** Das Protokoll als Text, zum Kopieren und Vorzeigen. */
+export function protokollText(): string {
+  const zeilen = oeffentlichesProtokoll().map((e) => {
+    const dauer =
+      e.sekunden === null
+        ? "—"
+        : `${Math.floor(e.sekunden / 60)}:${String(e.sekunden % 60).padStart(2, "0")}`;
+    return [
+      e.begonnen,
+      e.spiel_id ?? "—",
+      dauer,
+      e.ergebnis ?? "—",
+      e.grund ?? "läuft",
+    ].join("  |  ");
+  });
+  return [
+    "Öffentliche Partien der KI (Quelle: localStorage, Schlüssel " +
+      PROTOKOLL_SCHLUESSEL +
+      ")",
+    `Erlaubnis: ${ERLAUBNIS.von}, ${ERLAUBNIS.am}. ${ERLAUBNIS.art}`,
+    "Beginn  |  Spiel-ID  |  Dauer  |  Ergebnis  |  Ende",
+    ...zeilen,
+    `(${zeilen.length} Einträge)`,
+  ].join("\n");
+}
+
+// ── Sperre über Tabs hinweg ────────────────────────────────────────────────────
+// `let laufend` im Modul reicht nicht: zwei Tabs sind zwei Module. Die Sperre steht
+// darum in localStorage und wird regelmässig aufgefrischt; bleibt sie stehen, weil ein
+// Tab abgestürzt ist, verfällt sie nach SPERRE_FRISCH_MS von selbst.
+const meineKennung = `${Date.now().toString(36)}-${Math.floor(Math.random() * 1e6).toString(36)}`;
+let sperrTakt: ReturnType<typeof setInterval> | null = null;
+
+// localStorage kann fehlen oder werfen (Safari im privaten Modus, blockierte Cookies,
+// Testumgebung ohne DOM). Ohne Speicher gibt es weder Sperre noch Protokoll — und dann
+// lieber gar keine öffentliche Partie, siehe oeffentlichAnmelden().
+function speicher(): Storage | null {
+  try {
+    const s = globalThis.localStorage;
+    if (!s) return null;
+    s.getItem(SPERRE_SCHLUESSEL);
+    return s;
+  } catch {
+    return null;
+  }
+}
+
+function sperreLesen(): { kennung: string; zeit: number } | null {
+  try {
+    const r = JSON.parse(speicher()?.getItem(SPERRE_SCHLUESSEL) || "null");
+    return r && typeof r.kennung === "string" && typeof r.zeit === "number"
+      ? r
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+function sperreNehmen(): boolean {
+  const s = speicher();
+  if (!s) return false;
+  const da = sperreLesen();
+  if (
+    da &&
+    da.kennung !== meineKennung &&
+    Date.now() - da.zeit < SPERRE_FRISCH_MS
+  ) {
+    return false;
+  }
+  const auffrischen = () =>
+    s.setItem(
+      SPERRE_SCHLUESSEL,
+      JSON.stringify({ kennung: meineKennung, zeit: Date.now() }),
+    );
+  auffrischen();
+  sperrTakt ??= setInterval(() => {
+    if (sperreLesen()?.kennung !== meineKennung) return; // jemand anders hat übernommen
+    auffrischen();
+  }, SPERRE_TAKT_MS);
+  return true;
+}
+
+function sperreLoesen(): void {
+  if (sperrTakt !== null) {
+    clearInterval(sperrTakt);
+    sperrTakt = null;
+  }
+  if (sperreLesen()?.kennung === meineKennung) {
+    speicher()?.removeItem(SPERRE_SCHLUESSEL);
+  }
+}
+
+// ── Ablauf einer Partie ────────────────────────────────────────────────────────
+let eintrag: ProtokollEintrag | null = null;
+let begonnenMs = 0;
+let letzterStand: string | null = null;
+
+function sichern(): void {
+  if (!eintrag) return;
+  const alle = oeffentlichesProtokoll();
+  alle[alle.length - 1] = eintrag;
+  schreibeProtokoll(alle);
+}
+
+/**
+ * Freigabe für öffentliche Partien holen. Gibt den Grund zurück, warum nicht — oder
+ * null, wenn es losgehen darf. Es wird nichts nach draussen geschickt: der Nutzer
+ * klickt sein Spiel danach selbst im normalen Startbildschirm an.
+ */
+export function oeffentlichAnmelden(): string | null {
+  if (!OEFFENTLICHE_LOBBYS_AN) {
+    return "Öffentliche Lobbys sind abgeschaltet (oeffentlicheLobby.ts).";
+  }
+  if (!ERLAUBNIS.erteilt) {
+    return "Kein Eintrag in ERLAUBNIS: ohne belegte Zustimmung passiert hier nichts.";
+  }
+  if (!erlaubnisGueltig()) {
+    return abgelaufenText();
+  }
+  if (typeof window !== "undefined" && window.parent !== window) {
+    return (
+      "Aus einem eingebetteten Fenster nicht: öffentlich gespielt wird nur aus " +
+      "einem eigenen, sichtbaren Fenster."
+    );
+  }
+  // Im selben Fenster: die Sperre in localStorage trägt die eigene Kennung und würde
+  // sich selbst wieder gewährt. Der Eintrag ist hier der Wächter.
+  if (eintrag !== null) {
+    return (
+      `In diesem Fenster läuft schon eine öffentliche Partie (höchstens ` +
+      `${GRENZE_GLEICHZEITIG} gleichzeitig).`
+    );
+  }
+  if (!speicher()) {
+    return (
+      "Ohne localStorage gibt es weder die Sperre auf eine Partie noch ein " +
+      "Protokoll — dann lieber gar nicht öffentlich spielen."
+    );
+  }
+  if (GRENZE_GLEICHZEITIG < 1 || !sperreNehmen()) {
+    return (
+      `Es läuft schon eine öffentliche Partie (höchstens ${GRENZE_GLEICHZEITIG} gleichzeitig). ` +
+      "Das andere Fenster schliessen oder zu Ende spielen lassen."
+    );
+  }
+
+  eintrag = {
+    begonnen: new Date().toISOString(),
+    beendet: null,
+    spiel_id: null,
+    sekunden: null,
+    ergebnis: null,
+    grund: null,
+  };
+  begonnenMs = Date.now();
+  const alle = oeffentlichesProtokoll();
+  alle.push(eintrag);
+  schreibeProtokoll(alle);
+
+  window.addEventListener("beforeunload", () =>
+    oeffentlichBeenden("Fenster geschlossen"),
+  );
+  window.addEventListener("pagehide", () =>
+    oeffentlichBeenden("Fenster geschlossen"),
+  );
+  return null;
+}
+
+// ── Anzeige: Spieldauer und Verlassen ──────────────────────────────────────────
+let leisteTakt: ReturnType<typeof setInterval> | null = null;
+let leiste: HTMLElement | null = null;
+
+/**
+ * Baut die Anzeige für die laufende öffentliche Partie: wie lange sie schon läuft und
+ * ein Knopf zum Verlassen. Eingehängt wird sie von `kiEinblendung.ts` in die kleine
+ * Einblendung am Rand, damit sie die normale Oberfläche nicht verdeckt.
+ *
+ * Es gibt bewusst keinen Timer, der von selbst abbricht. Ein Bot, der mitten in der
+ * Partie verschwindet, hinterlässt ein totes Volk und stört mehr als einer, der zu Ende
+ * spielt. Der Nutzer steigt selbst aus — die Uhr nimmt ihm nur das Rechnen ab und färbt
+ * sich nach fünf Minuten, der Grenze, die er sich selbst gesetzt hat.
+ */
+export function oeffentlichAnzeige(): HTMLElement | null {
+  if (!eintrag) return null;
+  if (leiste) return leiste;
+  leiste = document.createElement("div");
+  leiste.style.cssText =
+    "display:flex;gap:8px;align-items:center;flex-wrap:wrap;" +
+    "padding-top:4px;margin-top:4px;border-top:1px solid #3a4252";
+
+  const punkt = document.createElement("span");
+  punkt.textContent = "● öffentlich";
+  punkt.style.color = "#63d19e";
+
+  const uhr = document.createElement("span");
+  uhr.style.fontVariantNumeric = "tabular-nums";
+  uhr.style.fontWeight = "700";
+  uhr.textContent = "0:00";
+
+  const knopf = document.createElement("button");
+  knopf.textContent = "Partie verlassen";
+  knopf.style.cssText =
+    "background:#7a2732;color:#fff;border:1px solid #a6394a;border-radius:7px;" +
+    "padding:4px 10px;font:600 12px/1.2 system-ui,sans-serif;cursor:pointer";
+  knopf.onclick = () => {
+    // Derselbe Weg, den der Client selbst nimmt (Main.ts leaveGame): zurück auf die
+    // Startseite. Das schliesst die Verbindung, der Server sieht einen Spieler gehen —
+    // wie bei jedem, der das Fenster zumacht. Vorher das Protokoll schliessen.
+    oeffentlichBeenden("vom Nutzer verlassen");
+    window.location.href = "/";
+  };
+
+  const grenze = document.createElement("span");
+  grenze.style.color = "#8b93a3";
+  grenze.textContent = "bis " + erlaubnisEnde().toLocaleString("de-CH");
+
+  leiste.append(punkt, uhr, knopf, grenze);
+  leisteTakt = setInterval(() => {
+    const sek = Math.round((Date.now() - begonnenMs) / 1000);
+    uhr.textContent = `${Math.floor(sek / 60)}:${String(sek % 60).padStart(2, "0")}`;
+    uhr.style.color = sek >= 300 ? "#d9a441" : "#e7e9ee";
+    // Läuft die Erlaubnis mitten in der Partie ab: sagen, nicht heimlich abbrechen.
+    // Ein Volk, das mitten im Spiel verschwindet, stört die Mitspieler mehr als
+    // eines, das zu Ende gespielt wird — der Nutzer entscheidet.
+    if (!erlaubnisGueltig() && !grenze.dataset.gemeldet) {
+      grenze.dataset.gemeldet = "1";
+      grenze.style.color = "#e0574f";
+      grenze.textContent = "Erlaubnis abgelaufen — bitte zu Ende spielen und aufhören";
+      console.warn("[ki] " + abgelaufenText());
+    }
+  }, 1000);
+  return leiste;
+}
+
+function versteckeLeiste(): void {
+  if (leisteTakt !== null) {
+    clearInterval(leisteTakt);
+    leisteTakt = null;
+  }
+  leiste?.remove();
+  leiste = null;
+}
+
+/** Spiel-ID nachtragen, sobald der Nutzer eine Lobby betreten hat. */
+export function oeffentlichSpiel(spielId: string): void {
+  if (!eintrag || typeof spielId !== "string") return;
+  eintrag.spiel_id = spielId.slice(0, 64);
+  sichern();
+}
+
+/** Letzter bekannter Stand; daraus wird am Ende das Ergebnis. */
+export function oeffentlichStand(werte: {
+  tick?: number;
+  platz?: number;
+  lebende?: number;
+  gebiet?: number;
+  handlungen_je_1000?: number;
+}): void {
+  if (!eintrag) return;
+  const z = (x: unknown, n = 0) => {
+    const v = Number(x);
+    return Number.isFinite(v) ? v.toFixed(n) : "—";
+  };
+  letzterStand =
+    `Tick ${z(werte.tick)}, Platz ${z(werte.platz)}/${z(werte.lebende)}, ` +
+    `Gebiet ${z(Number(werte.gebiet) * 100, 2)} %, ` +
+    `${z(werte.handlungen_je_1000, 1)} Handlungen/1000`;
+}
+
+export function oeffentlichBeenden(grund: string): void {
+  if (!eintrag || eintrag.beendet) return;
+  eintrag.beendet = new Date().toISOString();
+  eintrag.sekunden = Math.round((Date.now() - begonnenMs) / 1000);
+  eintrag.ergebnis = letzterStand;
+  eintrag.grund = String(grund).slice(0, 80);
+  sichern();
+  eintrag = null;
+  letzterStand = null;
+  sperreLoesen();
+  versteckeLeiste();
+}
diff --git a/src/core/aiAnfrage.ts b/src/core/aiAnfrage.ts
new file mode 100644
index 000000000..aabf9414b
--- /dev/null
+++ b/src/core/aiAnfrage.ts
@@ -0,0 +1,77 @@
+/**
+ * AI-Viewer: Anfrage an den Inferenz-Server, genau wie der Materialisierer die
+ * Trainingsdaten schreibt (buildCtx und Zellblock in materializer/src/materialize.ts).
+ * Gemeinsam genutzt vom Worker und von aitest/ende_zu_ende_test.ts, damit der Test genau
+ * den Code prüft, der im Browser läuft.
+ *
+ * Felder: map_b64 (u8[18·90·180] roh, base64), cells_b64 (Zellfakten roh, 64'800 Byte),
+ * own, opps (mit user/clan), config (info.config roh), sid, allies, tick, decide_every,
+ * ctx {mapW, mapH, troops, gold, oppIds, oppSids, ownUnitIds, ownAttackIds}.
+ * Der alte Server (env/inf_server.py) liest davon map_b64, own, opps, config und ctx.
+ */
+import { CellFacts } from "./cellFacts";
+import { Game, Player } from "./game/Game";
+import { ObsEncoder } from "./obsModel";
+
+const MAPLEN = 18 * 90 * 180;
+
+export function b64(u8: Uint8Array): string {
+  let s = "";
+  for (let i = 0; i < u8.length; i += 0x8000) {
+    s += String.fromCharCode.apply(null, Array.from(u8.subarray(i, i + 0x8000)));
+  }
+  return btoa(s);
+}
+
+export class AiAnfrage {
+  readonly enc = new ObsEncoder(180, 90);
+  private readonly obs = new Float32Array(MAPLEN);
+  readonly u8 = new Uint8Array(MAPLEN);
+  private cells: CellFacts | null = null;
+  private cellsGame: Game | null = null;
+  /** Letzter Zellblock (roh), für Tests. */
+  zellen: Uint8Array | null = null;
+
+  constructor(private readonly config: any) {}
+
+  baue(game: Game, player: Player, decideEvery: number): any {
+    this.enc.scanTick(game);
+    const v: any = this.enc.encodeVec(game, player, 24);
+    const allies = player.allies().map((a: any) => a.smallID());
+    this.enc.encodeMap(player, new Set(allies), this.obs);
+    for (let k = 0; k < MAPLEN; k++) {
+      let x = this.obs[k];
+      if (x < -1) x = -1; else if (x > 1) x = 1;
+      this.u8[k] = Math.round((x + 1) * 127.5);
+    }
+    const oppIds = v.opponents.map((o: any) => {
+      const pl: any = game.playerBySmallID(o.id);
+      return pl?.isPlayer() ? pl.id() : null;
+    });
+    const opps = v.opponents.map((o: any) => {
+      const pl: any = game.playerBySmallID(o.id);
+      return { ...o, user: pl?.isPlayer() ? pl.name() : null, clan: pl?.isPlayer() ? pl.clanTag() : null };
+    });
+    let cells_b64: string | undefined;
+    try {
+      if (this.cellsGame !== game) {
+        this.cells = new CellFacts(game, { legalBit1: true });   // wie LEGAL_BIT1=1 im Materialisierer
+        this.cellsGame = game;
+      }
+      this.zellen = this.cells!.compute(game, player, (this.enc as any).ownerG);
+      cells_b64 = b64(this.zellen);
+    } catch {
+      this.zellen = null;                  // ohne Zellfakten: der Server wählt keine räumliche Aktion
+    }
+    return {
+      map_b64: b64(this.u8), cells_b64, own: v.own, opps, config: this.config ?? {},
+      sid: player.smallID(), allies, tick: game.ticks(), decide_every: decideEvery,
+      ctx: {
+        mapW: game.width(), mapH: game.height(), troops: player.troops(), gold: Number(player.gold()),
+        oppIds, oppSids: v.opponents.map((o: any) => o.id),
+        ownUnitIds: player.units().map((u: any) => u.id()),
+        ownAttackIds: player.outgoingAttacks().map((a: any) => a.id()),
+      },
+    };
+  }
+}
diff --git a/src/core/aiKonfig.ts b/src/core/aiKonfig.ts
new file mode 100644
index 000000000..b01efe0d2
--- /dev/null
+++ b/src/core/aiKonfig.ts
@@ -0,0 +1,96 @@
+/**
+ * Einstellungen des KI-Clients, aus der Adresse gelesen.
+ *
+ * Portiert aus dem Viewer-Client (Commit 88cc95d8) auf den aktuellen Stand. Weggefallen
+ * sind die Felder des Vierfenster-Viewers (`zuschauen`, `relay`, `name`): dieser Client
+ * spielt in genau einem Fenster, mit der normalen Oberfläche.
+ *
+ *   /?ki=1&inf=http://127.0.0.1:8650&takt=32
+ *
+ * | Feld          | Bedeutung                                                      |
+ * |---------------|----------------------------------------------------------------|
+ * | `ki`          | 1 = das Modell steuert diesen Spieler                           |
+ * | `inf`         | Basis des Inferenz-Servers; `/inf` geht über den vite-Proxy      |
+ * | `auto`        | 1 = Einzelspiel von selbst starten (nur ohne `oeffentlich`)      |
+ * | `karte`       | Kartenname, sonst wählt das Modal zufällig                       |
+ * | `groesse`     | `Normal` oder `Compact`                                         |
+ * | `bots`        | Zahl der eingebauten Bots                                       |
+ * | `tempo`       | ms je Zug im Einzelspiel; 0 = Vorgabe des Clients                |
+ * | `takt`        | Startwert für decide_every; der Server darf ihn überschreiben    |
+ * | `oeffentlich` | 1 = öffentliche Lobby: der Nutzer wählt Spiel und Startpunkt     |
+ * | `spawnselbst` | 1 = das Modell setzt seinen Startpunkt selbst                    |
+ *
+ * Ohne Parameter ist alles aus: dann ist das hier der ganz normale Client, in dem der
+ * Nutzer selbst spielt.
+ */
+export interface AiKonfig {
+  ki: boolean;
+  inf: string;
+  auto: boolean;
+  karte: string | null;
+  groesse: string | null;
+  bots: number | null;
+  tempoMs: number;
+  takt: number;
+  /** Öffentliche Lobby: der Nutzer bedient den Startbildschirm und setzt den Startpunkt. */
+  oeffentlich: boolean;
+  /** Setzt das Modell seinen Startpunkt selbst? In öffentlichen Partien tut es das nicht. */
+  spawnSelbst: boolean;
+}
+
+export const AI_AUS: AiKonfig = {
+  ki: false,
+  inf: "/inf",
+  auto: false,
+  karte: null,
+  groesse: null,
+  bots: null,
+  tempoMs: 0,
+  takt: 32,
+  oeffentlich: false,
+  spawnSelbst: false,
+};
+
+function janein(v: string | null, vorgabe: boolean): boolean {
+  if (v === null) return vorgabe;
+  return v === "1" || v === "true" || v === "";
+}
+
+export function aiKonfigAus(suche: string): AiKonfig {
+  const p = new URLSearchParams(suche);
+  const ki = janein(p.get("ki"), false);
+  // Öffentliche Partie: der Nutzer klickt sich selbst in ein Spiel und setzt seinen
+  // Startpunkt. Darum kein Autostart, und das Modell setzt den Startpunkt nicht — es
+  // übernimmt erst nach der Startphase.
+  const oeffentlich = janein(p.get("oeffentlich"), false);
+  // Leerer Wert zählt als "nicht angegeben": Number("") ist 0, und ein Takt 0 würde im
+  // Worker zu `tick % 0` (NaN) führen — das Modell handelte dann nie. Untergrenze mit.
+  const zahl = (n: string, vorgabe: number | null, min = 0) => {
+    const v = p.get(n);
+    if (v === null || v.trim() === "") return vorgabe;
+    const x = Number(v);
+    return Number.isFinite(x) && x >= min ? x : vorgabe;
+  };
+  return {
+    ki,
+    inf: (p.get("inf") || "/inf").replace(/\/+$/, ""),
+    auto: janein(p.get("auto"), ki && !oeffentlich),
+    karte: p.get("karte"),
+    groesse: p.get("groesse"),
+    bots: zahl("bots", null),
+    tempoMs: zahl("tempo", 0) ?? 0,
+    takt: zahl("takt", 32, 1) ?? 32,
+    oeffentlich,
+    spawnSelbst: janein(p.get("spawnselbst"), ki && !oeffentlich),
+  };
+}
+
+/** Die Konfiguration dieses Fensters (nur Hauptseite; der Worker bekommt sie geschickt). */
+export function aiKonfig(): AiKonfig {
+  const g = globalThis as any;
+  if (!g.__AI_KONFIG__) {
+    g.__AI_KONFIG__ =
+      typeof location === "undefined" ? AI_AUS : aiKonfigAus(location.search);
+  }
+  return g.__AI_KONFIG__ as AiKonfig;
+}
diff --git a/src/core/aiZiel.ts b/src/core/aiZiel.ts
new file mode 100644
index 000000000..1089a0908
--- /dev/null
+++ b/src/core/aiZiel.ts
@@ -0,0 +1,124 @@
+/**
+ * AI-Viewer, D0-Spielregel im Client: Zelle → Kachel und Prüfung mit der Engine.
+ *
+ * Der Inferenz-Server (trainer/inf_d0.py) liefert bis zu 5 Zellen im 90×180-Raster, beste
+ * zuerst. Je Zelle wird nach der Regel der Gruppe eine Kachel gewählt (Entwurf
+ * ZIELWAHL §6, Spalte "Spielzeit") und mit der Engine geprüft. Die erste gültige Zelle
+ * gewinnt (Top-5-Rückfall, Entwurf §4 Punkt 6); ist keine gültig, entfällt die Aktion.
+ *
+ *   bau          eigenes Bauwerk gleichen Typs in der Zelle (Upgrade), sonst eigene Kachel
+ *                nächst Zellmitte; player.canBuild
+ *   hafen        eigene Küstenkachel nächst Zellmitte; player.canBuild
+ *   boot         Kachel des Ziels (herrenlos: freies Land) nächst Zellmitte; canBuildTransportShip
+ *   atom, wasserstoff  Kachel nächst Zellmitte; player.canBuild und nicht wouldNukeBreakAlliance
+ *   mirv         Kachel des Ziels; player.canBuild
+ *   kriegsschiff Wasserkachel nächst Zellmitte; player.canBuild
+ *   schiff_bewegen  Wasserkachel in der Komponente des Schiffs
+ *   spawn        herrenloses Land nächst Zellmitte
+ */
+import { wouldNukeBreakAlliance } from "./execution/Util";
+import { Game, Player, UnitType } from "./game/Game";
+import { TileRef } from "./game/GameMap";
+import { canBuildTransportShip } from "./game/TransportShipUtils";
+
+const GW = 180;
+const GH = 90;
+const PRUEF_MAX = 24; // Kacheln je Zelle, die höchstens mit der Engine geprüft werden
+
+/** Zelle wie obsModel/cellFacts: Zeile (y*90/H)|0, Spalte (x*180/W)|0. */
+export function zelleVon(game: Game, t: TileRef): number {
+  return (((game.y(t) * GH) / game.height()) | 0) * GW + (((game.x(t) * GW) / game.width()) | 0);
+}
+
+/** Kacheln einer Zelle, nach Abstand zur Zellmitte sortiert. */
+export function zellKacheln(game: Game, zelle: number): TileRef[] {
+  const W = game.width(), H = game.height();
+  const gx = zelle % GW, gy = (zelle / GW) | 0;
+  // x gehört zur Spalte gx, wenn gx*W/180 <= x < (gx+1)*W/180
+  const x0 = Math.ceil((gx * W) / GW), x1 = Math.min(W, Math.ceil(((gx + 1) * W) / GW));
+  const y0 = Math.ceil((gy * H) / GH), y1 = Math.min(H, Math.ceil(((gy + 1) * H) / GH));
+  const cx = (x0 + x1 - 1) / 2, cy = (y0 + y1 - 1) / 2;
+  const out: { t: TileRef; d: number }[] = [];
+  for (let y = y0; y < y1; y++) {
+    for (let x = x0; x < x1; x++) out.push({ t: game.ref(x, y), d: (x - cx) ** 2 + (y - cy) ** 2 });
+  }
+  out.sort((a, b) => a.d - b.d);
+  return out.map((o) => o.t);
+}
+
+function erste(kacheln: TileRef[], passt: (t: TileRef) => boolean, gueltig: (t: TileRef) => boolean): TileRef | null {
+  let geprueft = 0;
+  for (const t of kacheln) {
+    if (!passt(t)) continue;
+    if (gueltig(t)) return t;
+    if (++geprueft >= PRUEF_MAX) break;
+  }
+  return null;
+}
+
+function kachelInZelle(game: Game, player: Player, antwort: any, intent: any, zelle: number): TileRef | null {
+  const sid = player.smallID();
+  const k = zellKacheln(game, zelle);
+  const g: string = antwort.gruppe;
+  const ziel: number = antwort.zielSid ?? -1;
+  const bau = (typ: UnitType) => (t: TileRef) => player.canBuild(typ, t) !== false;
+  switch (g) {
+    case "bau":
+    case "hafen": {
+      const typ = intent.unit as UnitType;
+      const eigen = player.units(typ).find((u) => u.isActive() && zelleVon(game, u.tile()) === zelle);
+      if (eigen && player.canBuild(typ, eigen.tile()) !== false) return eigen.tile();
+      const passt = g === "hafen"
+        ? (t: TileRef) => game.ownerID(t) === sid && game.isShore(t)
+        : (t: TileRef) => game.ownerID(t) === sid && game.isLand(t);
+      return erste(k, passt, bau(typ));
+    }
+    case "kriegsschiff":
+      return erste(k, (t) => game.isWater(t), bau(UnitType.Warship));
+    case "atom":
+    case "wasserstoff": {
+      const typ = intent.unit as UnitType;
+      const allies = new Set(player.allies().map((a) => a.smallID()));
+      return erste(k, () => true, (t) => player.canBuild(typ, t) !== false && !wouldNukeBreakAlliance({
+        game, targetTile: t, magnitude: game.config().nukeMagnitudes(typ), allySmallIds: allies,
+        threshold: game.config().nukeAllianceBreakThreshold() }));
+    }
+    case "mirv":
+      return erste(k, (t) => game.ownerID(t) === ziel, bau(UnitType.MIRV));
+    case "boot":
+      return erste(k, (t) => game.isLand(t) && game.ownerID(t) === Math.max(0, ziel),
+        (t) => canBuildTransportShip(game, player, t) !== false);
+    case "schiff_bewegen": {
+      const schiffe = player.units(UnitType.Warship).filter((u) => u.isActive());
+      let schiff = schiffe.find((u) => u.id() === intent.unitIds?.[0]);
+      if (!schiff && schiffe.length) {
+        // own_ref zeigte auf keine Warship: nächstes eigenes Schiff zur Zelle nehmen
+        const m = k[0];
+        schiff = schiffe.reduce((a, b) => (game.manhattanDist(a.tile(), m) <= game.manhattanDist(b.tile(), m) ? a : b));
+      }
+      if (!schiff) return null;
+      intent.unitIds = [schiff.id()];
+      const comp = game.getWaterComponent(schiff.tile());
+      return erste(k, (t) => game.isWater(t) && game.getWaterComponent(t) === comp, () => true);
+    }
+    case "spawn":
+      return erste(k, (t) => game.isLand(t) && !game.hasOwner(t), () => true);
+  }
+  return null;
+}
+
+/**
+ * Antwort des D0-Servers → sendefertiger Intent oder null (keine gültige Zelle).
+ * Antworten ohne kandidaten (alter Server, nicht-räumliche Aktionen) gehen unverändert durch.
+ */
+export function intentAusAntwort(game: Game, player: Player, antwort: any): any | null {
+  const intent = antwort?.intent;
+  if (!intent || intent.type === "no_op") return null;
+  if (!antwort.kandidaten) return intent;
+  for (const zelle of antwort.kandidaten as number[]) {
+    const t = kachelInZelle(game, player, antwort, intent, zelle);
+    if (t === null) continue;
+    return intent.type === "boat" ? { ...intent, dst: t } : { ...intent, tile: t };
+  }
+  return null;
+}
