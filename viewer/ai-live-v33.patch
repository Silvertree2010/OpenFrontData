+import { describe, expect, it } from "vitest";
+import { AI_AUS, aiKonfigAus } from "../src/core/aiKonfig";
+
+describe("aiKonfigAus", () => {
+  it("ist ohne Parameter komplett aus — dann ist das der normale Client", () => {
+    const k = aiKonfigAus("");
+    expect(k.ki).toBe(false);
+    expect(k.auto).toBe(false);
+    expect(k.oeffentlich).toBe(false);
+    expect(k).toEqual(AI_AUS);
+  });
+
+  it("startet bei ki=1 von selbst, sperrt aber die Eingaben nicht", () => {
+    const k = aiKonfigAus("?ki=1");
+    expect(k.ki).toBe(true);
+    expect(k.auto).toBe(true);
+    expect(k.spawnSelbst).toBe(true);
+  });
+
+  it("öffentlich: kein Autostart, kein eigener Startpunkt", () => {
+    const k = aiKonfigAus("?ki=1&oeffentlich=1");
+    expect(k.oeffentlich).toBe(true);
+    expect(k.auto).toBe(false); // der Nutzer klickt sein Spiel selbst an
+    expect(k.spawnSelbst).toBe(false); // und setzt seinen Startpunkt selbst
+  });
+
+  it("nimmt den Inferenz-Server aus der Adresse, ohne Schrägstrich am Ende", () => {
+    expect(aiKonfigAus("?inf=http://10.0.0.1:8651/").inf).toBe(
+      "http://10.0.0.1:8651",
+    );
+    expect(aiKonfigAus("?inf=http://10.0.0.1:8652").inf).toBe(
+      "http://10.0.0.1:8652",
+    );
+    expect(aiKonfigAus("").inf).toBe("/inf");
+  });
+
+  it("liest Karte, Grösse, Bots, Tempo und Takt", () => {
+    const k = aiKonfigAus(
+      "?ki=1&karte=Bosphorus%20Straits&groesse=Compact&bots=40&tempo=60&takt=16",
+    );
+    expect(k.karte).toBe("Bosphorus Straits");
+    expect(k.groesse).toBe("Compact");
+    expect(k.bots).toBe(40);
+    expect(k.tempoMs).toBe(60);
+    expect(k.takt).toBe(16);
+  });
+
+  it("verwirft Unsinn in Zahlenfeldern, statt NaN weiterzureichen", () => {
+    const k = aiKonfigAus("?bots=viele&tempo=schnell&takt=");
+    expect(k.bots).toBeNull();
+    expect(k.tempoMs).toBe(0);
+    expect(k.takt).toBe(32);
+  });
+});
diff --git a/tests/OeffentlicheLobby.test.ts b/tests/OeffentlicheLobby.test.ts
