+#!/usr/bin/env bash
+# Startet den KI-Client gegen die echten Server von openfront.io.
+#
+# Alle Werte stammen aus BOOTSTRAP_CONFIG der ausgelieferten Seite, im Browser
+# ausgelesen (12.09.2026). GIT_COMMIT ist die ausgelieferte Kennung: der Spielserver
+# nimmt nur Clients an, deren Kennung seiner entspricht. Der Quelltext hier IST dieser
+# Commit plus dem KI-Teil; an der Simulation ist nichts geändert. Der Entwickler hat
+# dem ausdrücklich zugestimmt (siehe ERLAUBNIS in src/client/oeffentlicheLobby.ts).
+#
+# Captcha und Anmeldung laufen ganz normal im Browser des Nutzers. Hier wird nichts
+# umgangen, gefälscht oder automatisiert.
+set -euo pipefail
+
+export GIT_COMMIT=577819ba0e1e13ecdbc8dede2ba33de542c88a67   # v0.33.14, ausgeliefert
+export GAME_ENV=prod                 # sonst schickt der Client gar keinen Turnstile-Token
+export NUM_WORKERS=20
+export TURNSTILE_SITE_KEY=0x4AAAAAACFLkaecN39lS8sk
+export DOMAIN=openfront.io           # jwtAudience
+export SERVER_HOST=openfront.io      # Spielserver (sonst: eigener Ursprung)
+export API_DOMAIN=api.openfront.io   # Konto-API
+export SKIP_BROWSER_OPEN=true
+export INF_URL="${INF_URL:-http://127.0.0.1:8650}"   # Ziel des /inf-Proxys
+
+PORT="${PORT:-9010}"
+echo "Client auf http://localhost:${PORT}/"
+echo "Öffentliche Partie:  http://localhost:${PORT}/?ki=1&oeffentlich=1&inf=http://127.0.0.1:8650&takt=32"
+echo "Eigenes Testspiel:   http://localhost:${PORT}/?ki=1&auto=1&karte=World&bots=40&inf=http://127.0.0.1:8650&takt=32"
+exec npx vite --port "$PORT" --strictPort
