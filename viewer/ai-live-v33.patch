@@ -0,0 +1,118 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import {
+  erlaubnisEnde,
+  erlaubnisGueltig,
+  ERLAUBNIS,
+  GRENZE_GLEICHZEITIG,
+  OEFFENTLICHE_LOBBYS_AN,
+  oeffentlichAnmelden,
+  oeffentlichBeenden,
+  oeffentlichSpiel,
+  oeffentlichStand,
+  oeffentlichesProtokoll,
+  protokollText,
+} from "../src/client/oeffentlicheLobby";
+
+// jsdom liefert hier kein localStorage; das Modul kommt damit zurecht (dann keine
+// öffentliche Partie), für den Test braucht es aber einen echten Speicher.
+if (!globalThis.localStorage) {
+  const daten = new Map<string, string>();
+  Object.defineProperty(globalThis, "localStorage", {
+    configurable: true,
+    value: {
+      getItem: (k: string) => daten.get(k) ?? null,
+      setItem: (k: string, v: string) => void daten.set(k, String(v)),
+      removeItem: (k: string) => void daten.delete(k),
+      clear: () => daten.clear(),
+      key: (i: number) => [...daten.keys()][i] ?? null,
+      get length() {
+        return daten.size;
+      },
+    },
+  });
+}
+
+describe("öffentliche Lobbys", () => {
+  beforeEach(() => {
+    localStorage.clear();
+  });
+
+  it("ist eingeschaltet und die Erlaubnis ist belegt", () => {
+    expect(OEFFENTLICHE_LOBBYS_AN).toBe(true);
+    expect(ERLAUBNIS.erteilt).toBe(true);
+    expect(ERLAUBNIS.von).toBeTruthy();
+    expect(ERLAUBNIS.am).toBeTruthy();
+    // Die Kennzeichnung macht der Server; das muss dokumentiert sein.
+    expect(ERLAUBNIS.art).toMatch(/Server/);
+  });
+
+  it("hat eine harte Zeitgrenze und verweigert danach den Dienst", () => {
+    // Die Bot-Kennzeichnung der IP gilt nur bis zu diesem Zeitpunkt.
+    expect(ERLAUBNIS.laeuftAbAm).toBe("2026-09-13T12:00:00");
+    expect(erlaubnisGueltig(new Date("2026-09-13T11:59:00"))).toBe(true);
+    expect(erlaubnisGueltig(new Date("2026-09-13T12:00:01"))).toBe(false);
+    expect(erlaubnisEnde().getFullYear()).toBe(2026);
+    // Der Build trägt die ausgelieferte Kennung — das muss belegt sein.
+    expect(ERLAUBNIS.build).toMatch(/GIT_COMMIT/);
+    expect(ERLAUBNIS.fundstelle).toMatch(/ye sure/);
+  });
+
+  it("lässt genau eine Partie gleichzeitig zu", () => {
+    expect(GRENZE_GLEICHZEITIG).toBe(1);
+    expect(oeffentlichAnmelden()).toBeNull();
+    // Zweiter Anlauf, solange die erste läuft: abgelehnt, mit Begründung.
+    const zweiter = oeffentlichAnmelden();
+    expect(zweiter).toMatch(/schon eine öffentliche Partie/); // im selben Fenster
+    oeffentlichBeenden("Test");
+    // Nach dem Ende ist die Sperre wieder frei.
+    expect(oeffentlichAnmelden()).toBeNull();
+    oeffentlichBeenden("Test");
+  });
+
+  it("schreibt Beginn, Spiel-ID, Dauer und wie beendet ins Protokoll", () => {
+    expect(oeffentlichAnmelden()).toBeNull();
+    oeffentlichSpiel("abc123");
+    oeffentlichStand({
+      tick: 900,
+      platz: 4,
+      lebende: 30,
+      gebiet: 0.0312,
+      handlungen_je_1000: 28.4,
+    });
+    oeffentlichBeenden("vom Nutzer verlassen");
+
+    const p = oeffentlichesProtokoll();
+    expect(p).toHaveLength(1);
+    expect(p[0].spiel_id).toBe("abc123");
+    expect(p[0].begonnen).toMatch(/^\d{4}-\d{2}-\d{2}T/);
+    expect(p[0].beendet).toMatch(/^\d{4}-\d{2}-\d{2}T/);
+    expect(p[0].sekunden).toBeGreaterThanOrEqual(0);
+    expect(p[0].grund).toBe("vom Nutzer verlassen");
+    expect(p[0].ergebnis).toMatch(/Platz 4\/30/);
+    expect(protokollText()).toContain("abc123");
+  });
+
+  it("setzt keine eigene Abbruchgrenze — ein Eintrag bleibt offen, bis er beendet wird", () => {
+    expect(oeffentlichAnmelden()).toBeNull();
+    const p = oeffentlichesProtokoll();
+    expect(p[0].beendet).toBeNull();
+    expect(p[0].grund).toBeNull();
+    expect(protokollText()).toContain("läuft");
+    oeffentlichBeenden("Test");
+  });
+
+  it("lehnt eingebettete Fenster ab — eingebettete Fenster spielen nicht öffentlich", () => {
+    const echt = Object.getOwnPropertyDescriptor(window, "parent");
+    Object.defineProperty(window, "parent", { value: {}, configurable: true });
+    try {
+      expect(oeffentlichAnmelden()).toMatch(/eingebetteten Fenster/);
+    } finally {
+      if (echt) Object.defineProperty(window, "parent", echt);
+      else
+        Object.defineProperty(window, "parent", {
+          value: window,
+          configurable: true,
+        });
+    }
+  });
+});
