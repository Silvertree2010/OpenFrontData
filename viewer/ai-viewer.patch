new file mode 100644
index 000000000..95919f729
--- /dev/null
+++ b/src/client/RelayServer.ts
@@ -0,0 +1,98 @@
+// Viewer-Seite des geteilten Spiels. Ersetzt im Spectator-Modus den LocalServer:
+// statt Turns selbst zu erzeugen, spielt er den vom Host gebroadcasteten
+// kanonischen Turn-Stream (ueber das Relay) ab. Gleiches Interface wie
+// LocalServer (updateCallback / start / onMessage / turnComplete / endGame),
+// damit Transport unveraendert funktioniert.
+//
+// Wichtig (der Bug davor): der Client schickt beim Start rejoinGame(0) und
+// erwartet als Antwort ein "start" mit ALLEN bisherigen Turns (so faehrt er
+// seinen turnsSeen hoch). Ohne diese Antwort verwirft er jeden Live-Turn als
+// "wrong turn" -> Spiel bleibt auf TICK 0. Wir puffern also alle Turns und
+// beantworten rejoin mit start{turns: alle}.
+//
+// Determinismus: alle Viewer laden denselben Client-Build (gleiche Engine),
+// bekommen dieselbe gameStartInfo (Seed) und denselben Turn-Stream. Keine
+// Inferenz im Viewer.
+
+import { ClientMessage, ServerMessage, Turn } from "../core/Schemas";
+import { LobbyConfig } from "./ClientGameRunner";
+
+export class RelayServer {
+  private turns: Turn[] = [];
+  private clientConnect: () => void = () => {};
+  private clientMessage: (m: ServerMessage) => void = () => {};
+
+  constructor(private lobbyConfig: LobbyConfig) {}
+
+  public updateCallback(
+    clientConnect: () => void,
+    clientMessage: (m: ServerMessage) => void,
+  ) {
+    this.clientConnect = clientConnect;
+    this.clientMessage = clientMessage;
+  }
+
+  private startMsg(turns: Turn[]): ServerMessage {
+    const si = this.lobbyConfig.gameStartInfo!;
+    return {
+      type: "start",
+      gameStartInfo: si,
+      turns,
+      lobbyCreatedAt: si.lobbyCreatedAt,
+      // myClientID = Modell-Client -> Viewer sieht den Bot als "myPlayer"
+      // (HUD/Auto-Cam folgen ihm). Steuerung ist ohnehin geblockt.
+      myClientID: this.lobbyConfig.spectatorRelay!.clientID,
+    } as ServerMessage;
+  }
+
+  start() {
+    const relay = this.lobbyConfig.spectatorRelay;
+    const si = this.lobbyConfig.gameStartInfo;
+    if (!relay || !si) throw new Error("RelayServer: missing relay/startInfo");
+
+    // Backlog (bis jetzt) + waehrend des Bootstraps eingetroffene Turns puffern.
+    this.turns = relay.backlog.slice();
+    for (const m of relay.queue.splice(0)) {
+      if (m?.type === "turn") this.turns.push(m.turn);
+      else if (m?.type === "reset") return location.reload();
+    }
+
+    // Ab jetzt live: jeder Turn -> puffern + an den Client schieben.
+    relay.ws.onmessage = (ev: MessageEvent) => {
+      let m: any;
+      try {
+        m = JSON.parse(ev.data);
+      } catch {
+        return;
+      }
+      if (m.type === "turn") {
+        this.turns.push(m.turn);
+        this.clientMessage({ type: "turn", turn: m.turn } as ServerMessage);
+      } else if (m.type === "reset") {
+        location.reload(); // Host hat ein neues Spiel gestartet
+      }
+    };
+    relay.ws.onclose = () => setTimeout(() => location.reload(), 2500);
+
+    // Initiales start{turns:[]} -> Client erzeugt das Spiel (createClientGame).
+    // Den eigentlichen Catch-up liefert die rejoin-Antwort unten.
+    this.clientConnect();
+    this.clientMessage(this.startMsg([]));
+  }
+
+  // Client -> "Server". Nur rejoin ist relevant: mit ALLEN Turns antworten,
+  // damit turnsSeen hochlaeuft und Live-Turns danach akzeptiert werden.
+  onMessage(msg: ClientMessage) {
+    if (msg && (msg as any).type === "rejoin") {
+      this.clientMessage(this.startMsg(this.turns));
+    }
+  }
+
+  turnComplete() {}
+
+  endGame() {
+    try {
+      this.lobbyConfig.spectatorRelay?.ws.close();
+    } catch {}
+  }
+}
