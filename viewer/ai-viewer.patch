diff --git a/relay_server.mjs b/relay_server.mjs
new file mode 100644
index 000000000..eea187bf2
--- /dev/null
+++ b/relay_server.mjs
@@ -0,0 +1,144 @@
+// Autoritatives-Spiel-Relay fuer den geteilten Watch-Modus.
+//
+// EIN Host (der lokale Mac-Browser, ?host bzw. localhost) spielt das kanonische
+// Spiel und schickt seinen Turn-Stream hierher; alle Viewer bekommen exakt
+// diesen Stream und spielen ihn deterministisch nach -> alle sehen dasselbe.
+//
+// Host  -> Relay:  {t:"init", startInfo, clientID}   (neues Spiel, Puffer leeren)
+//                  {t:"turn", turn}                   (jede Runde)
+// Relay -> Viewer: {type:"init", startInfo, clientID, turns:[...]}  (bei Connect: Backlog)
+//                  {type:"turn", turn}                              (live)
+//                  {type:"reset"}                                   (Host startet neues Spiel)
+//
+// Kein State auf Platte, nur RAM. Laeuft lokal auf dem Mac, wird via
+// vite-Proxy /relay (und damit tailscale-funnel) oeffentlich erreichbar.
+
+import { timingSafeEqual } from "node:crypto";
+import { WebSocketServer } from "ws";
+
+const PORT = Number(process.env.RELAY_PORT ?? 8652);
+// An die Loopback-Adresse binden, nicht an alle Schnittstellen. Vorher stand im Log
+// ws://127.0.0.1:8652, gelauscht wurde aber auf *:8652 — wer im Tailnet war, konnte sich
+// mit ?role=host als Host ausgeben und allen Zuschauern einen eigenen Zugstrom
+// unterschieben. Geprueft wurde nichts. Von aussen erreichbar ist das Relay ohnehin nur
+// ueber den vite-Proxy /relay, und der laeuft auf derselben Maschine.
+const ADRESSE = process.env.RELAY_HOST ?? "127.0.0.1";
+// Nur noetig, wenn jemand RELAY_HOST bewusst weiter aufmacht: dann muss der Host ein
+// Geheimnis mitschicken (?role=host&token=…).
+const TOKEN = process.env.RELAY_HOST_TOKEN ?? "";
+const NUR_LOKAL =
+  ADRESSE === "127.0.0.1" || ADRESSE === "::1" || ADRESSE === "localhost";
+if (!NUR_LOKAL && !TOKEN) {
+  console.error(
+    `relay_server: RELAY_HOST=${ADRESSE} oeffnet das Relay fuer das Netz. Dann ist ` +
+      `RELAY_HOST_TOKEN Pflicht, sonst kann jeder die Host-Rolle uebernehmen.`,
+  );
+  process.exit(2);
+}
+const wss = new WebSocketServer({ port: PORT, host: ADRESSE });
+
+/** @type {{startInfo:any, clientID:any, turns:any[]}|null} */
+let game = null;
+const viewers = new Set();
+let hostSock = null;
+
+function broadcast(obj) {
+  const s = JSON.stringify(obj);
+  for (const v of viewers) {
+    if (v.readyState === 1) {
+      try {
+        v.send(s);
+      } catch {}
+    }
+  }
+}
+
+/** Zeitkonstanter Vergleich, damit das Geheimnis nicht Zeichen fuer Zeichen zu raten ist. */
+function tokenStimmt(gegeben) {
+  if (!TOKEN) return true; // kein Geheimnis gesetzt = nur lokal, siehe oben
+  const a = Buffer.from(String(gegeben ?? ""));
+  const b = Buffer.from(TOKEN);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/** @returns {"host"|"viewer"|"abgelehnt"} */
+function rolleVon(req) {
+  let suche;
+  try {
+    suche = new URL(req.url, "http://x").searchParams;
+  } catch {
+    return "viewer";
+  }
+  if (suche.get("role") !== "host") return "viewer";
+  if (!tokenStimmt(suche.get("token"))) return "abgelehnt";
+  // Einen lebenden Host nicht verdraengen. Ohne Geheimnis waere das der einfachste Weg,
+  // die Partie zu kapern; mit Geheimnis ist es erlaubt (dann war es der Berechtigte).
+  if (hostSock && hostSock.readyState === 1 && !TOKEN) return "abgelehnt";
+  return "host";
+}
+
+wss.on("connection", (ws, req) => {
+  const rolle = rolleVon(req);
+  if (rolle === "abgelehnt") {
+    console.warn("[relay] host-Anfrage abgelehnt");
+    try {
+      ws.close(1008, "host abgelehnt");
+    } catch {}
+    return;
+  }
+  if (rolle === "host") {
+    hostSock = ws;
+    console.log("[relay] host connected");
+    ws.on("message", (buf) => {
+      let m;
+      try {
+        m = JSON.parse(buf.toString());
+      } catch {
+        return;
+      }
+      if (m.t === "init") {
+        game = { startInfo: m.startInfo, clientID: m.clientID, turns: [] };
+        console.log(
+          "[relay] new game",
+          game.startInfo?.gameID,
+          "-> reset viewers",
+        );
+        broadcast({ type: "reset" }); // Viewer laden neu und holen frisches Spiel
+      } else if (m.t === "turn" && game) {
+        game.turns.push(m.turn);
+        broadcast({ type: "turn", turn: m.turn });
+      }
+    });
+    ws.on("close", () => {
+      if (hostSock === ws) hostSock = null;
+      console.log("[relay] host disconnected");
+    });
+    return;
+  }
+
+  // Viewer
+  viewers.add(ws);
+  console.log(`[relay] viewer connected (${viewers.size} total)`);
+  if (game) {
+    ws.send(
+      JSON.stringify({
+        type: "init",
+        startInfo: game.startInfo,
+        clientID: game.clientID,
+        turns: game.turns,
+      }),
+    );
+  } else {
+    ws.send(JSON.stringify({ type: "wait" }));
+  }
+  ws.on("close", () => {
+    viewers.delete(ws);
+    console.log(`[relay] viewer left (${viewers.size} total)`);
+  });
+  ws.on("error", () => viewers.delete(ws));
+});
+
+console.log(
+  `relay_server on ws://${ADRESSE}:${PORT} (role=host to publish` +
+    `${TOKEN ? ", token noetig" : ", nur lokal"})`,
+);
diff --git a/resources/vier.html b/resources/vier.html
new file mode 100644
index 000000000..f4fd4c094
--- /dev/null
+++ b/resources/vier.html
@@ -0,0 +1,441 @@
+<!doctype html>
+<html lang="de">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Vierfenster-Viewer — vier Modelle beim Spielen</title>
+    <style>
+      :root {
+        --rand: #2a2f3a;
+        --grund: #14171d;
+        --hell: #e7e9ee;
+        --matt: #8b93a3;
+        --gut: #63d19e;
+      }
+      * {
+        box-sizing: border-box;
+      }
+      html,
+      body {
+        height: 100%;
+        margin: 0;
+        background: var(--grund);
+        color: var(--hell);
+        font:
+          13px/1.45 ui-sans-serif,
+          system-ui,
+          sans-serif;
+      }
+      body {
+        display: flex;
+        flex-direction: column;
+      }
+      header {
+        display: flex;
+        gap: 10px;
+        align-items: center;
+        flex-wrap: wrap;
+        padding: 8px 12px;
+        background: #11141a;
+        border-bottom: 1px solid var(--rand);
+      }
+      header h1 {
+        font-size: 14px;
+        margin: 0 12px 0 0;
+        font-weight: 600;
+      }
+      button,
+      select,
+      input {
+        background: #1d222c;
+        color: var(--hell);
+        border: 1px solid var(--rand);
+        border-radius: 6px;
+        padding: 4px 9px;
+        font: inherit;
+      }
+      button {
+        cursor: pointer;
+      }
+      button:hover {
+        background: #262d3a;
+      }
+      button.an {
+        border-color: var(--gut);
+        color: var(--gut);
+      }
+      .netz {
+        flex: 1;
+        display: grid;
+        grid-template-columns: 1fr 1fr;
+        grid-template-rows: 1fr 1fr;
+        gap: 6px;
+        padding: 6px;
+        min-height: 0;
+      }
+      .netz.gross-0 {
+        grid-template-columns: 1fr 0fr;
+        grid-template-rows: 1fr 0fr;
+      }
+      .netz.gross-1 {
+        grid-template-columns: 0fr 1fr;
+        grid-template-rows: 1fr 0fr;
+      }
+      .netz.gross-2 {
+        grid-template-columns: 1fr 0fr;
+        grid-template-rows: 0fr 1fr;
+      }
+      .netz.gross-3 {
+        grid-template-columns: 0fr 1fr;
+        grid-template-rows: 0fr 1fr;
+      }
+      .netz.gross-0 .kachel:not(:nth-child(1)),
+      .netz.gross-1 .kachel:not(:nth-child(2)),
+      .netz.gross-2 .kachel:not(:nth-child(3)),
+      .netz.gross-3 .kachel:not(:nth-child(4)) {
+        display: none;
+      }
+      .kachel {
+        display: flex;
+        flex-direction: column;
+        min-width: 0;
+        min-height: 0;
+        border: 1px solid var(--rand);
+        border-radius: 8px;
+        overflow: hidden;
+        background: #0d1015;
+      }
+      .kopf {
+        display: flex;
+        gap: 6px;
+        align-items: center;
+        flex-wrap: wrap;
+        padding: 5px 7px;
+        background: #171b23;
+        border-bottom: 1px solid var(--rand);
+      }
+      .kopf .titel {
+        font-weight: 600;
+        margin-right: 4px;
+      }
+      .kopf select,
+      .kopf input,
+      .kopf button {
+        padding: 2px 6px;
+        font-size: 12px;
+      }
+      .kopf input.url {
+        width: 180px;
+      }
+      iframe {
+        flex: 1;
+        width: 100%;
+        border: 0;
+        background: #000;
+        min-height: 0;
+      }
+      .werte {
+        display: flex;
+        gap: 12px;
+        flex-wrap: wrap;
+        padding: 4px 7px;
+        background: #101319;
+        border-top: 1px solid var(--rand);
+        color: var(--matt);
+        font-variant-numeric: tabular-nums;
+        font-size: 12px;
+      }
+      .werte b {
+        color: var(--hell);
+        font-weight: 600;
+      }
+      .warn {
+        color: #d9a441;
+      }
+      footer {
+        padding: 5px 12px;
+        color: var(--matt);
+        font-size: 12px;
+        border-top: 1px solid var(--rand);
+        background: #11141a;
+      }
+    </style>
+  </head>
+  <body>
+    <header>
+      <h1>Vierfenster-Viewer</h1>
+      <button id="alle-pause">Alle Pause</button>
+      <button id="alle-weiter">Alle weiter</button>
+      <label
+        >Tempo alle
+        <select id="alle-tempo">
+          <option value="0">Vorgabe</option>
+          <option value="200">langsam (200 ms)</option>
+          <option value="100">normal (100 ms)</option>
+          <option value="40" selected>schnell (40 ms)</option>
+          <option value="15">sehr schnell (15 ms)</option>
+        </select>
+      </label>
+      <button id="alle-neu">Alle neu starten</button>
+      <label>Karte <input id="karte" value="World" size="12" /></label>
+      <label
+        >Bots
+        <input id="bots" type="number" value="40" min="0" max="400" size="4"
+      /></label>
+      <label><input type="checkbox" id="compact" checked /> Compact</label>
+      <button id="uebernehmen">Fenster 1 selbst spielen</button>
+      <span id="hinweis" class="warn"></span>
+    </header>
+
+    <div class="netz" id="netz"></div>
+
+    <footer>
+      Jedes Fenster ist ein eigener Client mit eigenem Spiel und eigenem
+      Inferenz-Server. Die Wahlart (Ziehen oder Argmax) steckt im Server, nicht
+      im Fenster — darum je Wahlart ein eigener Port, siehe
+      <code>viewer/starte_inf.sh</code>. Öffentliche Lobbys sind aus
+      (<code>src/client/oeffentlicheLobby.ts</code>).
+    </footer>
+
+    <script>
+      // ── Wer steht wo? Anpassen oder im Fenster direkt überschreiben. ──
+      // Die Wahlart ist eine Server-Einstellung (inf_d0 --ziehen/--temp/--top-k),
+      // darum gehört sie hier zum Eintrag und nicht ins Fenster.
+      // 8652/8653 sind bewusst nicht dabei: 8652 ist die Vorgabe von relay_server.mjs,
+      // und vite leitet /relay auf 127.0.0.1:8652 derselben Maschine.
+      const ARCH = "http://arch.example";
+      const SERVER = [
+        { name: "bc2 · Ziehen T1.0 k4", url: ARCH + ":8650" },
+        { name: "bc2 · Argmax", url: ARCH + ":8651" },
+        { name: "bc2_s60000 · Ziehen", url: ARCH + ":8654" },
+        { name: "bc2_s20000 · Ziehen", url: ARCH + ":8655" },
+      ];
+      const GESPEICHERT = "vier-viewer-server";
+      const gespeichert = (() => {
+        try {
+          return JSON.parse(localStorage.getItem(GESPEICHERT) || "null");
+        } catch {
+          return null;
+        }
+      })();
+      // Aus localStorage kommen Adressen, die einmal jemand eingetippt hat. Nur http(s)
+      // durchlassen — javascript:-Adressen haben in einem iframe nichts verloren.
+      const istErlaubt = (u) =>
+        /^https?:\/\/[^\s"'<>]+$/.test(String(u ?? "")) ||
+        /^\/[^\s"'<>]*$/.test(String(u ?? ""));
+      const zuweisung = (
+        Array.isArray(gespeichert) ? gespeichert : SERVER.map((s) => s.url)
+      )
+        .map((u, i) => (istErlaubt(u) ? u : SERVER[i].url))
+        .slice(0, 4);
+
+      const netz = document.getElementById("netz");
+      const fenster = [];
+
+      function adresse(i) {
+        const p = new URLSearchParams({
+          ki: "1",
+          inf: zuweisung[i],
+          auto: "1",
+          // Vier Kacheln nebeneinander: hier ist die Zuschauer-Ansicht richtig, die
+          // normale Oberfläche wäre auf einer Viertelseite unbedienbar. Im
+          // Einzelfenster ist sie aus, dort greift der Nutzer selbst ein.
+          zuschauen: "1",
+          name: "F" + (i + 1),
+          tempo: document.getElementById("alle-tempo").value,
+          karte: document.getElementById("karte").value.trim(),
+          groesse: document.getElementById("compact").checked
+            ? "Compact"
+            : "Normal",
+          bots: document.getElementById("bots").value,
+        });
+        return "/?" + p.toString();
+      }
+
+      function baue(i) {
+        const kachel = document.createElement("div");
+        kachel.className = "kachel";
+        // Festes Gerüst ohne Fremddaten (nur der Zähler i) — hier ist innerHTML in Ordnung.
+        kachel.innerHTML = `
+          <div class="kopf">
+            <span class="titel">Fenster ${i + 1}</span>
+            <select class="wahl"></select>
+            <input class="url" title="Inferenz-Server" />
+            <button class="pause">Pause</button>
+            <select class="tempo">
+              <option value="0">Vorgabe</option>
+              <option value="200">200 ms</option>
+              <option value="100">100 ms</option>
+              <option value="40">40 ms</option>
+              <option value="15">15 ms</option>
+            </select>
+            <button class="neu">Neu</button>
+            <button class="gross">Gross</button>
+          </div>
+          <iframe allow="autoplay"></iframe>
+          <div class="werte">wartet …</div>`;
+        netz.appendChild(kachel);
+
+        const wahl = kachel.querySelector(".wahl");
+        for (const s of SERVER) {
+          const o = document.createElement("option");
+          o.value = s.url;
+          o.textContent = s.name;
+          wahl.appendChild(o);
+        }
+        const o = document.createElement("option");
+        o.value = "__frei";
+        o.textContent = "eigene Adresse";
+        wahl.appendChild(o);
+        wahl.value = SERVER.some((s) => s.url === zuweisung[i])
+          ? zuweisung[i]
+          : "__frei";
+
+        const rahmen = kachel.querySelector("iframe");
+        const werte = kachel.querySelector(".werte");
+        const url = kachel.querySelector(".url");
+        // Wert per Eigenschaft, nicht per Attribut im HTML-Text: zuweisung kommt aus
+        // localStorage und ist damit Fremddaten-verdächtig.
+        url.value = String(zuweisung[i] ?? "");
+        const pause = kachel.querySelector(".pause");
+        const f = { kachel, rahmen, werte, pausiert: false };
+
+        const neuLaden = () => {
+          const eingabe = url.value.trim();
+          if (!istErlaubt(eingabe)) {
+            werte.textContent = "Adresse abgelehnt: nur http(s):// oder /pfad";
+            url.value = zuweisung[i];
+            return;
+          }
+          zuweisung[i] = eingabe;
+          localStorage.setItem(GESPEICHERT, JSON.stringify(zuweisung));
+          werte.textContent = "startet …";
+          f.pausiert = false;
+          pause.textContent = "Pause";
+          pause.classList.remove("an");
+          rahmen.src = adresse(i);
+        };
+
+        wahl.onchange = () => {
+          if (wahl.value !== "__frei") {
+            url.value = wahl.value;
+            neuLaden();
+          }
+        };
+        url.onchange = neuLaden;
+        kachel.querySelector(".neu").onclick = neuLaden;
+        pause.onclick = () => {
+          f.pausiert = !f.pausiert;
+          sende(i, { ki4: f.pausiert ? "pause" : "weiter" });
+          pause.textContent = f.pausiert ? "Weiter" : "Pause";
+          pause.classList.toggle("an", f.pausiert);
+        };
+        kachel.querySelector(".tempo").onchange = (e) =>
+          sende(i, { ki4: "tempo", ms: Number(e.target.value) });
+        kachel.querySelector(".gross").onclick = () => {
+          const an = netz.classList.contains("gross-" + i);
+          netz.className = "netz" + (an ? "" : " gross-" + i);
+        };
+
+        fenster.push(f);
+        rahmen.src = adresse(i);
+      }
+
+      function sende(i, nachricht) {
+        try {
+          fenster[i].rahmen.contentWindow.postMessage(nachricht, "*");
+        } catch {}
+      }
+      function anAlle(nachricht) {
+        fenster.forEach((_, i) => sende(i, nachricht));
+      }
+
+      for (let i = 0; i < 4; i++) baue(i);
+
+      document.getElementById("alle-pause").onclick = () => {
+        anAlle({ ki4: "pause" });
+        fenster.forEach((f) => {
+          f.pausiert = true;
+          const b = f.kachel.querySelector(".pause");
+          b.textContent = "Weiter";
+          b.classList.add("an");
+        });
+      };
+      document.getElementById("alle-weiter").onclick = () => {
+        anAlle({ ki4: "weiter" });
+        fenster.forEach((f) => {
+          f.pausiert = false;
+          const b = f.kachel.querySelector(".pause");
+          b.textContent = "Pause";
+          b.classList.remove("an");
+        });
+      };
+      document.getElementById("alle-tempo").onchange = (e) =>
+        anAlle({ ki4: "tempo", ms: Number(e.target.value) });
+      document.getElementById("alle-neu").onclick = () =>
+        fenster.forEach((f, i) => {
+          f.rahmen.src = adresse(i);
+        });
+      document.getElementById("uebernehmen").onclick = () => {
+        sende(0, { ki4: "uebernehmen" });
+        document.getElementById("hinweis").textContent =
+          "Fenster 1 nimmt jetzt Eingaben an. Das Modell spielt weiter mit.";
+      };
+
+      // Kennzahlenzeile: KEIN innerHTML. Die Werte kommen über postMessage aus dem
+      // Fenster und damit letztlich vom Inferenz-Server (letzte_aktion) und aus
+      // Spielerdaten. Sobald da ein fremder Name oder Text durchläuft, wäre innerHTML
+      // eine Einladung für eingeschleustes HTML. Zahlen gehen durch Number(), Texte
+      // ausschliesslich über textContent.
+      const zahl = (x, stellen = 0) => {
+        const n = Number(x);
+        return Number.isFinite(n) ? n.toFixed(stellen) : "—";
+      };
+      const prozent = (x) => {
+        const n = Number(x);
+        return Number.isFinite(n) ? (100 * n).toFixed(2) + " %" : "—";
+      };
+      /** Ein Feld "Beschriftung Wert", Wert fett. Beides als reiner Text. */
+      function feld(beschriftung, wert) {
+        const span = document.createElement("span");
+        span.append(document.createTextNode(beschriftung + " "));
+        const b = document.createElement("b");
+        b.textContent = String(wert);
+        span.append(b);
+        return span;
+      }
+      function zeigeWerte(ziel, w) {
+        ziel.replaceChildren(
+          feld("Tick", zahl(w.tick)),
+          feld("Gebiet", prozent(w.gebiet) + " (" + zahl(w.kacheln) + ")"),
+          feld("Platz", zahl(w.platz) + "/" + zahl(w.lebende)),
+          feld("Truppen", zahl(Number(w.truppen) / 1000) + "k"),
+          feld("Gold", zahl(Number(w.gold) / 1000) + "k"),
+          feld("Handlungen/1000", zahl(w.handlungen_je_1000, 1)),
+          feld("P(handeln)", w.p_handeln === null ? "—" : zahl(w.p_handeln, 3)),
+          // letzte_aktion ist der einzige freie Text vom Server — nur als Textknoten,
+          // und auf eine Länge gekürzt, die die Zeile nicht sprengt.
+          feld("Aktion", String(w.letzte_aktion ?? "—").slice(0, 40)),
+          feld("Schritt", w.ckpt_step === null ? "—" : zahl(w.ckpt_step)),
+        );
+      }
+
+      window.addEventListener("message", (ev) => {
+        const m = ev.data;
+        if (!m || typeof m.ki4 !== "string") return;
+        const i = fenster.findIndex(
+          (f) => f.rahmen.contentWindow === ev.source,
+        );
+        if (i < 0) return;
+        if (m.ki4 === "bereit") {
+          fenster[i].werte.textContent = "verbunden, wartet auf den Start …";
+        } else if (m.ki4 === "messwerte" && m.werte) {
+          zeigeWerte(fenster[i].werte, m.werte);
+        } else if (m.ki4 === "oeffentlich") {
+          fenster[i].werte.textContent =
+            "öffentliche Lobby abgelehnt: " + String(m.abgelehnt ?? "");
+        }
+      });
+    </script>
+  </body>
+</html>
diff --git a/share_host.ts b/share_host.ts
new file mode 100644
index 000000000..913b9ad15
--- /dev/null
+++ b/share_host.ts
@@ -0,0 +1,161 @@
+/**
+ * Autoritativer Headless-Host fuer das geteilte Watch-Spiel (laeuft auf apollo).
+ *
+ * Nutzt die CLIENT-eigene Engine (src/core) — exakt die, die die Viewer im
+ * Browser bundeln — treibt den Human-Spieler per BC-Modell (inf_server) und
+ * streamt den kanonischen Turn-Stream ans Relay. Viewer spielen ihn
+ * deterministisch nach (gleiche Engine + gleiche gameStartInfo + gleicher
+ * Turn-Stream) -> alle sehen dasselbe Spiel. Keine Inferenz in den Viewern.
+ *
+ * Laeuft endlos: stirbt/gewinnt das Modell, startet ein frisches Spiel (neues
+ * init ans Relay -> Viewer laden neu und resyncen).
+ *
+ *   tsx share_host.ts
+ */
+import path from "path";
+import { fileURLToPath } from "url";
+import { Config } from "./src/core/configuration/Config";
+import { Executor } from "./src/core/execution/ExecutionManager";
+import {
+  Difficulty,
+  Game,
+  GameMapSize,
+  GameMapType,
+  GameMode,
+  GameType,
+  PlayerInfo,
+  PlayerType,
+} from "./src/core/game/Game";
+import { createGame } from "./src/core/game/GameImpl";
+import { createNationsForGame } from "./src/core/game/NationCreation";
+import { loadTerrainMap } from "./src/core/game/TerrainMapLoader";
+import { GameRunner } from "./src/core/GameRunner";
+import { ObsEncoder } from "./src/core/obsModel";
+import { PseudoRandom } from "./src/core/PseudoRandom";
+import { GameStartInfo } from "./src/core/Schemas";
+import { simpleHash, toWireGameStartInfo } from "./src/core/Util";
+import { NodeGameMapLoader } from "./tests/perf/fullgame/NodeGameMapLoader";
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const INF = process.env.INF || "http://arch.example:8650/act";
+const RELAY = process.env.RELAY || "ws://127.0.0.1:8652/relay?role=host";
+const MODEL_CID = "modelbot0001";
+const GW = 180, GH = 90, MAPLEN = 18 * GW * GH;
+const DECIDE_EVERY = Number(process.env.DECIDE_EVERY ?? 8);
+const TICK_MS = Number(process.env.TICK_MS ?? 100);
+const MAX_TICKS = Number(process.env.MAX_TICKS ?? 20000);
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+const cfg: any = {
+  gameMap: GameMapType.World,
+  gameMapSize: GameMapSize.Normal,
+  gameMode: GameMode.FFA,
+  gameType: GameType.Singleplayer,
+  difficulty: Difficulty.Medium,
+  nations: "default",
+  donateGold: false, donateTroops: false, bots: 40,
+  infiniteGold: false, infiniteTroops: false, instantBuild: false, randomSpawn: false,
+};
+
+const modelPlayer = (game: Game) => game.players().find((p) => p.type() === PlayerType.Human);
+
+// ── Relay (persistent, auto-reconnect) ──
+let ws: WebSocket | null = null;
+let wsOpen = false;
+let curInit: any = null; // letztes init (fuer resend nach reconnect)
+function connectRelay() {
+  ws = new WebSocket(RELAY);
+  ws.onopen = () => { wsOpen = true; console.log("[relay] connected"); if (curInit) send({ t: "init", ...curInit }); };
+  ws.onclose = () => { wsOpen = false; console.log("[relay] closed, reconnect in 2s"); setTimeout(connectRelay, 2000); };
+  ws.onerror = () => { try { ws?.close(); } catch {} };
+}
+function send(obj: any) { if (ws && wsOpen) { try { ws.send(JSON.stringify(obj)); } catch {} } }
+
+async function decide(game: Game, enc: ObsEncoder, obsBuf: Float32Array, u8: Uint8Array): Promise<any | null> {
+  const player = modelPlayer(game);
+  if (!player) return null;
+  const v: any = enc.encodeVec(game, player, 24);
+  const allies = new Set(player.allies().map((a: any) => a.smallID()));
+  enc.encodeMap(player, allies, obsBuf);
+  for (let i = 0; i < obsBuf.length; i++) { let x = obsBuf[i]; x = x < -1 ? -1 : x > 1 ? 1 : x; u8[i] = Math.round((x + 1) * 127.5); }
+  const oppIds = v.opponents.map((o: any) => { const pl = game.playerBySmallID(o.id); return pl.isPlayer() ? pl.id() : null; });
+  const opps = v.opponents.map((o: any) => { const pl = game.playerBySmallID(o.id); return { ...o, user: pl.isPlayer() ? pl.name() : null, clan: pl.isPlayer() ? pl.clanTag() : null }; });
+  const body = {
+    map_u8: Array.from(u8), own: v.own, opps, config: {}, sample: true, temp: 0.9,
+    ctx: { mapW: game.width(), mapH: game.height(), troops: player.troops(), gold: Number(player.gold()),
+      oppIds, ownUnitIds: player.units().map((u: any) => u.id()), ownAttackIds: player.outgoingAttacks().map((a: any) => a.id()) },
+  };
+  try {
+    const r = await fetch(INF, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+    const j: any = await r.json();
+    if (!j.intent || j.intent.type === "no_op") return null;
+    return { ...j.intent, clientID: player.clientID() };
+  } catch { return null; }
+}
+
+async function playOneGame(): Promise<void> {
+  const players = [{ username: "🤖 BC-MODELL", clientID: MODEL_CID, isLobbyCreator: true, clanTag: "AI", friends: [], teamIndex: null }];
+  const gameStart: GameStartInfo = toWireGameStartInfo({ gameID: "share" + Date.now(), lobbyCreatedAt: Date.now(), config: cfg, players, tribes: [] } as any);
+  const config = new Config(cfg, null, false);
+  const terrain = await loadTerrainMap(cfg.gameMap, cfg.gameMapSize, new NodeGameMapLoader(path.join(ROOT, "resources/maps")), false);
+  const random = new PseudoRandom(simpleHash(gameStart.gameID));
+  const humans = gameStart.players.map((p) => new PlayerInfo(p.username, PlayerType.Human, p.clientID, random.nextID(), p.isLobbyCreator ?? false, p.clanTag, p.friends ?? [], p.teamIndex ?? null));
+  const nations = createNationsForGame(gameStart, terrain.nations, terrain.additionalNations, humans.length, random);
+  const game: Game = createGame(humans, nations, terrain.gameMap, terrain.miniGameMap, config, terrain.teamGameSpawnAreas);
+  let fatal: string | undefined;
+  const runner = new GameRunner(game, new Executor(game, gameStart.gameID, undefined, gameStart.tribes?.map((t: any) => t.name)), (gu: any) => { if ("errMsg" in gu) fatal = gu.errMsg; });
+  runner.init();
+
+  // Neues Spiel ans Relay -> Viewer resyncen.
+  curInit = { startInfo: gameStart, clientID: MODEL_CID };
+  send({ t: "init", ...curInit });
+
+  const enc = new ObsEncoder(GW, GH);
+  const obsBuf = new Float32Array(MAPLEN);
+  const u8 = new Uint8Array(MAPLEN);
+  const W = game.width(), H = game.height(), map = game.map();
+  const spawnTile = () => { for (let i = 0; i < 40000; i++) { const r = (Math.random() * W * H) | 0; const b = map.terrainByte(r); if ((b & (1 << 7)) && (b & 0x1f) !== 31) return r; } return (W * H / 2) | 0; };
+  let wasSpawned = false;
+  console.log(`▶ neues Spiel ${gameStart.gameID} (${cfg.gameMap} ${W}x${H}, bots=${cfg.bots})`);
+
+  for (let t = 0; t < MAX_TICKS; t++) {
+    const tickStart = Date.now();
+    const intents: any[] = [];
+    const player = modelPlayer(game);
+    if (player && !wasSpawned) { wasSpawned = true; console.log(`✅ Modell gespawnt @${t} smallID=${player.smallID()}`); }
+    if (!player && game.inSpawnPhase() && t % 20 === 0) {
+      intents.push({ type: "spawn", tile: spawnTile(), clientID: MODEL_CID });
+    } else if (player && player.isAlive() && t % DECIDE_EVERY === 0) {
+      enc.scanTick(game);
+      const intent = await decide(game, enc, obsBuf, u8);
+      if (intent) intents.push(intent);
+    }
+    const turn = { turnNumber: t, intents };
+    runner.addTurn(turn as any);
+    runner.executeNextTick((runner as any).pendingTurns ? (runner as any).pendingTurns() : 1);
+    send({ t: "turn", turn });
+    if (fatal) { console.log(`FATAL @${t}: ${fatal}`); return; }
+
+    // Ende: Modell tot (nach Spawn) oder nur noch <=1 lebt.
+    const aliveHumans = game.players().filter((p) => p.isAlive());
+    const meDead = wasSpawned && !modelPlayer(game)?.isAlive();
+    if (meDead) { console.log(`☠ Modell tot @${t}`); return; }
+    if (aliveHumans.length <= 1 && !game.inSpawnPhase() && t > 200) { console.log(`🏁 Spiel vorbei @${t}`); return; }
+
+    const elapsed = Date.now() - tickStart;
+    if (elapsed < TICK_MS) await sleep(TICK_MS - elapsed);
+  }
+  console.log("Spiel: MAX_TICKS erreicht");
+}
+
+async function main() {
+  console.debug = () => {};
+  connectRelay();
+  await sleep(500);
+  // Endlos: nach jedem Spiel kurz warten (Viewer sehen Ergebnis), dann neues.
+  while (true) {
+    try { await playOneGame(); } catch (e: any) { console.error("game error:", e?.stack ?? e); }
+    await sleep(4000);
+  }
+}
+main().catch((e) => { console.error("FATAL", e?.stack ?? e); process.exit(1); });
