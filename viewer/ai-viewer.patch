+}
+
+// Geteiltes Spiel: Host streamt seinen kanonischen Turn-Stream ans Relay; Viewer
+// spielen nur nach (Modell aus). _relayRole: "host" | "viewer" | null (=Solo).
+let _relayRole: "host" | "viewer" | null = null;
