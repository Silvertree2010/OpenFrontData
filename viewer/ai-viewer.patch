diff --git a/relay_server.mjs b/relay_server.mjs
new file mode 100644
index 000000000..fee94ea67
--- /dev/null
+++ b/relay_server.mjs
@@ -0,0 +1,95 @@
+// Autoritatives-Spiel-Relay fuer den geteilten Watch-Modus.
+//
+// EIN Host (der lokale Mac-Browser, ?host bzw. localhost) spielt das kanonische
+// Spiel und schickt seinen Turn-Stream hierher; alle Viewer bekommen exakt
+// diesen Stream und spielen ihn deterministisch nach -> alle sehen dasselbe.
+//
+// Host  -> Relay:  {t:"init", startInfo, clientID}   (neues Spiel, Puffer leeren)
+//                  {t:"turn", turn}                   (jede Runde)
+// Relay -> Viewer: {type:"init", startInfo, clientID, turns:[...]}  (bei Connect: Backlog)
+//                  {type:"turn", turn}                              (live)
+//                  {type:"reset"}                                   (Host startet neues Spiel)
+//
+// Kein State auf Platte, nur RAM. Laeuft lokal auf dem Mac, wird via
+// vite-Proxy /relay (und damit tailscale-funnel) oeffentlich erreichbar.
+
+import { WebSocketServer } from "ws";
+
+const PORT = Number(process.env.RELAY_PORT ?? 8652);
+const wss = new WebSocketServer({ port: PORT });
+
+/** @type {{startInfo:any, clientID:any, turns:any[]}|null} */
+let game = null;
+const viewers = new Set();
+let hostSock = null;
+
+function broadcast(obj) {
+  const s = JSON.stringify(obj);
+  for (const v of viewers) {
+    if (v.readyState === 1) {
+      try {
+        v.send(s);
+      } catch {}
+    }
+  }
+}
+
+function isHost(req) {
+  try {
+    return new URL(req.url, "http://x").searchParams.get("role") === "host";
+  } catch {
+    return false;
+  }
+}
+
+wss.on("connection", (ws, req) => {
+  if (isHost(req)) {
+    // Neuer Host uebernimmt; alter (falls vorhanden) wird ersetzt.
+    hostSock = ws;
+    console.log("[relay] host connected");
+    ws.on("message", (buf) => {
+      let m;
+      try {
+        m = JSON.parse(buf.toString());
+      } catch {
+        return;
+      }
+      if (m.t === "init") {
+        game = { startInfo: m.startInfo, clientID: m.clientID, turns: [] };
+        console.log("[relay] new game", game.startInfo?.gameID, "-> reset viewers");
+        broadcast({ type: "reset" }); // Viewer laden neu und holen frisches Spiel
+      } else if (m.t === "turn" && game) {
+        game.turns.push(m.turn);
+        broadcast({ type: "turn", turn: m.turn });
+      }
+    });
+    ws.on("close", () => {
+      if (hostSock === ws) hostSock = null;
+      console.log("[relay] host disconnected");
+    });
+    return;
+  }
+
+  // Viewer
+  viewers.add(ws);
+  console.log(`[relay] viewer connected (${viewers.size} total)`);
+  if (game) {
+    ws.send(
+      JSON.stringify({
+        type: "init",
+        startInfo: game.startInfo,
+        clientID: game.clientID,
+        turns: game.turns,
+      }),
+    );
+  } else {
+    ws.send(JSON.stringify({ type: "wait" }));
+  }
+  ws.on("close", () => {
+    viewers.delete(ws);
+    console.log(`[relay] viewer left (${viewers.size} total)`);
+  });
+  ws.on("error", () => viewers.delete(ws));
+});
+
+console.log(`relay_server on ws://127.0.0.1:${PORT} (role=host to publish)`);
diff --git a/share_host.ts b/share_host.ts
new file mode 100644
index 000000000..913b9ad15
--- /dev/null
+++ b/share_host.ts
@@ -0,0 +1,161 @@
+/**
+ * Autoritativer Headless-Host fuer das geteilte Watch-Spiel (laeuft auf apollo).
+ *
+ * Nutzt die CLIENT-eigene Engine (src/core) — exakt die, die die Viewer im
+ * Browser bundeln — treibt den Human-Spieler per BC-Modell (inf_server) und
+ * streamt den kanonischen Turn-Stream ans Relay. Viewer spielen ihn
+ * deterministisch nach (gleiche Engine + gleiche gameStartInfo + gleicher
+ * Turn-Stream) -> alle sehen dasselbe Spiel. Keine Inferenz in den Viewern.
+ *
+ * Laeuft endlos: stirbt/gewinnt das Modell, startet ein frisches Spiel (neues
+ * init ans Relay -> Viewer laden neu und resyncen).
+ *
+ *   tsx share_host.ts
+ */
+import path from "path";
+import { fileURLToPath } from "url";
+import { Config } from "./src/core/configuration/Config";
+import { Executor } from "./src/core/execution/ExecutionManager";
+import {
+  Difficulty,
+  Game,
+  GameMapSize,
+  GameMapType,
+  GameMode,
+  GameType,
+  PlayerInfo,
+  PlayerType,
+} from "./src/core/game/Game";
+import { createGame } from "./src/core/game/GameImpl";
+import { createNationsForGame } from "./src/core/game/NationCreation";
+import { loadTerrainMap } from "./src/core/game/TerrainMapLoader";
+import { GameRunner } from "./src/core/GameRunner";
+import { ObsEncoder } from "./src/core/obsModel";
+import { PseudoRandom } from "./src/core/PseudoRandom";
+import { GameStartInfo } from "./src/core/Schemas";
+import { simpleHash, toWireGameStartInfo } from "./src/core/Util";
+import { NodeGameMapLoader } from "./tests/perf/fullgame/NodeGameMapLoader";
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const INF = process.env.INF || "http://100.120.102.64:8650/act";
+const RELAY = process.env.RELAY || "ws://127.0.0.1:8652/relay?role=host";
+const MODEL_CID = "modelbot0001";
+const GW = 180, GH = 90, MAPLEN = 18 * GW * GH;
+const DECIDE_EVERY = Number(process.env.DECIDE_EVERY ?? 8);
+const TICK_MS = Number(process.env.TICK_MS ?? 100);
+const MAX_TICKS = Number(process.env.MAX_TICKS ?? 20000);
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+const cfg: any = {
+  gameMap: GameMapType.World,
+  gameMapSize: GameMapSize.Normal,
+  gameMode: GameMode.FFA,
+  gameType: GameType.Singleplayer,
+  difficulty: Difficulty.Medium,
+  nations: "default",
+  donateGold: false, donateTroops: false, bots: 40,
+  infiniteGold: false, infiniteTroops: false, instantBuild: false, randomSpawn: false,
+};
+
+const modelPlayer = (game: Game) => game.players().find((p) => p.type() === PlayerType.Human);
+
+// ── Relay (persistent, auto-reconnect) ──
+let ws: WebSocket | null = null;
+let wsOpen = false;
+let curInit: any = null; // letztes init (fuer resend nach reconnect)
+function connectRelay() {
+  ws = new WebSocket(RELAY);
+  ws.onopen = () => { wsOpen = true; console.log("[relay] connected"); if (curInit) send({ t: "init", ...curInit }); };
+  ws.onclose = () => { wsOpen = false; console.log("[relay] closed, reconnect in 2s"); setTimeout(connectRelay, 2000); };
+  ws.onerror = () => { try { ws?.close(); } catch {} };
+}
+function send(obj: any) { if (ws && wsOpen) { try { ws.send(JSON.stringify(obj)); } catch {} } }
+
+async function decide(game: Game, enc: ObsEncoder, obsBuf: Float32Array, u8: Uint8Array): Promise<any | null> {
+  const player = modelPlayer(game);
+  if (!player) return null;
+  const v: any = enc.encodeVec(game, player, 24);
+  const allies = new Set(player.allies().map((a: any) => a.smallID()));
+  enc.encodeMap(player, allies, obsBuf);
+  for (let i = 0; i < obsBuf.length; i++) { let x = obsBuf[i]; x = x < -1 ? -1 : x > 1 ? 1 : x; u8[i] = Math.round((x + 1) * 127.5); }
+  const oppIds = v.opponents.map((o: any) => { const pl = game.playerBySmallID(o.id); return pl.isPlayer() ? pl.id() : null; });
+  const opps = v.opponents.map((o: any) => { const pl = game.playerBySmallID(o.id); return { ...o, user: pl.isPlayer() ? pl.name() : null, clan: pl.isPlayer() ? pl.clanTag() : null }; });
+  const body = {
+    map_u8: Array.from(u8), own: v.own, opps, config: {}, sample: true, temp: 0.9,
+    ctx: { mapW: game.width(), mapH: game.height(), troops: player.troops(), gold: Number(player.gold()),
+      oppIds, ownUnitIds: player.units().map((u: any) => u.id()), ownAttackIds: player.outgoingAttacks().map((a: any) => a.id()) },
+  };
+  try {
+    const r = await fetch(INF, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+    const j: any = await r.json();
+    if (!j.intent || j.intent.type === "no_op") return null;
+    return { ...j.intent, clientID: player.clientID() };
+  } catch { return null; }
+}
+
+async function playOneGame(): Promise<void> {
+  const players = [{ username: "🤖 BC-MODELL", clientID: MODEL_CID, isLobbyCreator: true, clanTag: "AI", friends: [], teamIndex: null }];
+  const gameStart: GameStartInfo = toWireGameStartInfo({ gameID: "share" + Date.now(), lobbyCreatedAt: Date.now(), config: cfg, players, tribes: [] } as any);
+  const config = new Config(cfg, null, false);
+  const terrain = await loadTerrainMap(cfg.gameMap, cfg.gameMapSize, new NodeGameMapLoader(path.join(ROOT, "resources/maps")), false);
+  const random = new PseudoRandom(simpleHash(gameStart.gameID));
+  const humans = gameStart.players.map((p) => new PlayerInfo(p.username, PlayerType.Human, p.clientID, random.nextID(), p.isLobbyCreator ?? false, p.clanTag, p.friends ?? [], p.teamIndex ?? null));
+  const nations = createNationsForGame(gameStart, terrain.nations, terrain.additionalNations, humans.length, random);
+  const game: Game = createGame(humans, nations, terrain.gameMap, terrain.miniGameMap, config, terrain.teamGameSpawnAreas);
+  let fatal: string | undefined;
+  const runner = new GameRunner(game, new Executor(game, gameStart.gameID, undefined, gameStart.tribes?.map((t: any) => t.name)), (gu: any) => { if ("errMsg" in gu) fatal = gu.errMsg; });
+  runner.init();
+
+  // Neues Spiel ans Relay -> Viewer resyncen.
+  curInit = { startInfo: gameStart, clientID: MODEL_CID };
+  send({ t: "init", ...curInit });
+
+  const enc = new ObsEncoder(GW, GH);
+  const obsBuf = new Float32Array(MAPLEN);
+  const u8 = new Uint8Array(MAPLEN);
+  const W = game.width(), H = game.height(), map = game.map();
+  const spawnTile = () => { for (let i = 0; i < 40000; i++) { const r = (Math.random() * W * H) | 0; const b = map.terrainByte(r); if ((b & (1 << 7)) && (b & 0x1f) !== 31) return r; } return (W * H / 2) | 0; };
+  let wasSpawned = false;
+  console.log(`▶ neues Spiel ${gameStart.gameID} (${cfg.gameMap} ${W}x${H}, bots=${cfg.bots})`);
+
+  for (let t = 0; t < MAX_TICKS; t++) {
+    const tickStart = Date.now();
+    const intents: any[] = [];
+    const player = modelPlayer(game);
+    if (player && !wasSpawned) { wasSpawned = true; console.log(`✅ Modell gespawnt @${t} smallID=${player.smallID()}`); }
+    if (!player && game.inSpawnPhase() && t % 20 === 0) {
+      intents.push({ type: "spawn", tile: spawnTile(), clientID: MODEL_CID });
+    } else if (player && player.isAlive() && t % DECIDE_EVERY === 0) {
+      enc.scanTick(game);
+      const intent = await decide(game, enc, obsBuf, u8);
+      if (intent) intents.push(intent);
+    }
+    const turn = { turnNumber: t, intents };
+    runner.addTurn(turn as any);
+    runner.executeNextTick((runner as any).pendingTurns ? (runner as any).pendingTurns() : 1);
+    send({ t: "turn", turn });
+    if (fatal) { console.log(`FATAL @${t}: ${fatal}`); return; }
+
+    // Ende: Modell tot (nach Spawn) oder nur noch <=1 lebt.
+    const aliveHumans = game.players().filter((p) => p.isAlive());
+    const meDead = wasSpawned && !modelPlayer(game)?.isAlive();
+    if (meDead) { console.log(`☠ Modell tot @${t}`); return; }
+    if (aliveHumans.length <= 1 && !game.inSpawnPhase() && t > 200) { console.log(`🏁 Spiel vorbei @${t}`); return; }
+
+    const elapsed = Date.now() - tickStart;
+    if (elapsed < TICK_MS) await sleep(TICK_MS - elapsed);
+  }
+  console.log("Spiel: MAX_TICKS erreicht");
+}
+
+async function main() {
+  console.debug = () => {};
+  connectRelay();
+  await sleep(500);
+  // Endlos: nach jedem Spiel kurz warten (Viewer sehen Ergebnis), dann neues.
+  while (true) {
+    try { await playOneGame(); } catch (e: any) { console.error("game error:", e?.stack ?? e); }
+    await sleep(4000);
+  }
+}
+main().catch((e) => { console.error("FATAL", e?.stack ?? e); process.exit(1); });
