@@ -0,0 +1,262 @@
+// Vollstaendig custom Spectator-UI fuer den "Automated AI Game"-Watch-Client.
+// - blendet die komplette Standard-OpenFront-HUD aus (nur im Spiel: body.in-game)
+// - zeichnet ein eigenes Sci-Fi-Overlay: Banner, Live-Leaderboard, Modell-Stats,
+//   Tick/Frame, dekorativer Rahmen
+// - liest den Live-Spielzustand aus (window.__GV__ = GameView, in GameRenderer gesetzt)
+//
+// Reines Zuschauen: pointer-events der HUD sind aus, manuelles Pan/Zoom laeuft
+// weiter durch das Input-Overlay. Spiel-Intents sind separat via Transport
+// (__SPECTATOR__ -> sendIntent no-op) unterbunden.
+
+// Standard-HUD-Elemente, die im Spiel verborgen werden (scoped auf body.in-game).
+const HIDE_TAGS = [
+  "control-panel", "build-menu", "events-display", "actionable-events",
+  "attacks-display", "chat-display", "chat-modal", "player-info-overlay",
+  "player-panel", "player-profile-modal", "player-moderation-modal",
+  "win-modal", "new-lobby-prompt", "replay-panel", "game-right-sidebar",
+  "game-left-sidebar", "settings-modal", "graphics-settings-modal",
+  "unit-display", "multi-tab-modal", "heads-up-message", "performance-overlay",
+  "alert-frame", "spawn-timer", "immunity-timer", "in-game-promo",
+  "emoji-table", "leaderboard-modal", "team-stats", "send-resource-modal",
+  "help-modal", "desktop-nav-bar", "mobile-nav-bar", "featured-stream",
+];
+
+const CSS = `
+body.in-game ${HIDE_TAGS.join(", body.in-game ")},
+body.in-game .radial-menu-container,
+body.in-game .radial-tooltip { display: none !important; }
+
+#ai-hud, #ai-hud * { box-sizing: border-box; }
+#ai-hud {
+  position: fixed; inset: 0; z-index: 2147483000; pointer-events: none;
+  font-family: "SF Mono", ui-monospace, "Roboto Mono", Menlo, monospace;
+  color: #dff6ff; --cy: #22e3ff; --dim: rgba(154,196,214,.6);
+}
+/* dekorativer Rahmen + Vignette */
+#ai-hud .frame {
+  position: absolute; inset: 0;
+  box-shadow: inset 0 0 160px rgba(0,0,0,.55), inset 0 0 2px rgba(34,227,255,.35);
+  border: 1px solid rgba(34,227,255,.10);
+}
+#ai-hud .corner { position: absolute; width: 26px; height: 26px; border: 2px solid var(--cy); opacity: .55; }
+#ai-hud .corner.tl { top: 44px; left: 12px; border-right: 0; border-bottom: 0; }
+#ai-hud .corner.tr { top: 44px; right: 12px; border-left: 0; border-bottom: 0; }
+#ai-hud .corner.bl { bottom: 12px; left: 12px; border-right: 0; border-top: 0; }
+#ai-hud .corner.br { bottom: 12px; right: 12px; border-left: 0; border-top: 0; }
+
+#ai-banner {
+  position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center;
+  justify-content: center; gap: 12px; padding: 9px 14px;
+  font-weight: 700; font-size: 13.5px; letter-spacing: 2.5px; text-transform: uppercase;
+  color: #eafcff; text-shadow: 0 0 10px rgba(34,227,255,.6);
+  background: linear-gradient(180deg, rgba(4,8,15,.94), rgba(4,8,15,.4));
+  border-bottom: 1px solid rgba(34,227,255,.4);
+}
+#ai-banner .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--cy);
+  box-shadow: 0 0 10px var(--cy); animation: aiblink 1.4s infinite; }
+#ai-banner .sub { opacity: .55; letter-spacing: 2px; }
+@keyframes aiblink { 50% { opacity: .2; } }
+
+.ai-panel {
+  position: absolute; background: linear-gradient(160deg, rgba(6,12,20,.86), rgba(6,12,20,.62));
+  border: 1px solid rgba(34,227,255,.28); border-radius: 10px; padding: 10px 12px;
+  backdrop-filter: blur(3px); box-shadow: 0 6px 26px rgba(0,0,0,.45), inset 0 0 24px rgba(34,227,255,.05);
+}
+.ai-panel .ph { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--cy);
+  opacity: .85; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
+.ai-panel .ph::before { content: ""; width: 5px; height: 5px; background: var(--cy);
+  box-shadow: 0 0 6px var(--cy); border-radius: 50%; }
+
+#ai-board { left: 14px; bottom: 20px; width: 268px; }
+#ai-board .row { display: grid; grid-template-columns: 20px 1fr auto; align-items: center;
+  gap: 8px; padding: 3px 0; font-size: 12px; position: relative; }
+#ai-board .row .rk { color: var(--dim); text-align: right; font-size: 11px; }
+#ai-board .row .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; z-index: 1; }
+#ai-board .row .tl { color: #bfe9f6; font-variant-numeric: tabular-nums; z-index: 1; }
+#ai-board .row .bar { position: absolute; left: 28px; right: 0; bottom: 1px; height: 100%;
+  background: rgba(34,227,255,.07); border-radius: 3px; z-index: 0; }
+#ai-board .row.me .nm, #ai-board .row.me .tl { color: #eafcff; font-weight: 700; }
+#ai-board .row.me { text-shadow: 0 0 8px rgba(34,227,255,.5); }
+#ai-board .row.me .bar { background: rgba(34,227,255,.20); box-shadow: inset 0 0 0 1px rgba(34,227,255,.4); }
+#ai-board .row.dead .nm, #ai-board .row.dead .tl { color: rgba(154,196,214,.35); }
+
+#ai-model { right: 14px; bottom: 20px; width: 210px; }
+#ai-model .status { font-size: 13px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 10px; }
+#ai-model .status.alive { color: var(--cy); text-shadow: 0 0 10px rgba(34,227,255,.55); }
+#ai-model .status.dead { color: #ff6b6b; text-shadow: 0 0 10px rgba(255,107,107,.5); }
+#ai-model .stat { display: flex; justify-content: space-between; font-size: 12px; padding: 3px 0; }
+#ai-model .stat .k { color: var(--dim); letter-spacing: 1px; }
+#ai-model .stat .v { color: #eafcff; font-variant-numeric: tabular-nums; font-weight: 600; }
+
+#ai-tick { top: 52px; right: 14px; padding: 6px 12px; font-size: 12px; letter-spacing: 2px;
+  color: var(--cy); }
+#ai-tick .v { color: #eafcff; font-weight: 700; }
+`;
+
+function compact(n: number): string {
+  const a = Math.abs(n);
+  if (a >= 1e9) return (n / 1e9).toFixed(1) + "B";
+  if (a >= 1e6) return (n / 1e6).toFixed(1) + "M";
+  if (a >= 1e3) return (n / 1e3).toFixed(1) + "k";
+  return String(Math.round(n));
+}
+
+function el(tag: string, cls?: string, text?: string): HTMLElement {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text !== undefined) e.textContent = text;
+  return e;
+}
+
+export function installSpectatorUI(): void {
+  if (document.getElementById("ai-hud")) return;
+
+  const style = document.createElement("style");
+  style.textContent = CSS;
+  document.head.appendChild(style);
+
+  const hud = el("div");
+  hud.id = "ai-hud";
+
+  const frame = el("div", "frame");
+  for (const c of ["tl", "tr", "bl", "br"]) frame.appendChild(el("div", "corner " + c));
+  hud.appendChild(frame);
+
+  // Banner
+  const banner = el("div");
+  banner.id = "ai-banner";
+  banner.appendChild(el("span", "dot"));
+  banner.appendChild(el("span", undefined, "🤖 Automated AI Game"));
+  banner.appendChild(el("span", "sub", "· Spectate only · BC model live"));
+  hud.appendChild(banner);
+
+  // Tick
+  const tick = el("div", "ai-panel");
+  tick.id = "ai-tick";
+  const tickV = el("span", "v", "0");
+  tick.append("TICK ", tickV);
+  hud.appendChild(tick);
+
+  // Leaderboard
+  const board = el("div", "ai-panel");
+  board.id = "ai-board";
+  board.appendChild(el("div", "ph", "Live Standings"));
+  const boardBody = el("div");
+  board.appendChild(boardBody);
+  hud.appendChild(board);
+
+  // Model stats
+  const model = el("div", "ai-panel");
+  model.id = "ai-model";
+  model.appendChild(el("div", "ph", "The Model"));
+  const status = el("div", "status", "◌ Standby");
+  model.appendChild(status);
+  const stats: Record<string, HTMLElement> = {};
+  for (const k of ["Territory", "Gold", "Troops", "Rank"]) {
+    const row = el("div", "stat");
+    row.appendChild(el("span", "k", k));
+    const v = el("span", "v", "–");
+    row.appendChild(v);
+    stats[k] = v;
+    model.appendChild(row);
+  }
+  hud.appendChild(model);
+
+  document.body.appendChild(hud);
+
+  // Auto-Restart: sobald das Modell (nach dem Spawn) stirbt oder das Spiel
+  // entschieden ist, kurze Gnadenfrist -> frisches Spiel laden.
+  let seenAlive = false;
+  let restarting = false;
+  const scheduleRestart = (reason: string) => {
+    if (restarting) return;
+    restarting = true;
+    status.className = "status dead";
+    let n = 5;
+    status.textContent = `↻ ${reason} · new game in ${n}s`;
+    const iv = setInterval(() => {
+      n -= 1;
+      status.textContent = `↻ ${reason} · new game in ${n}s`;
+      if (n <= 0) {
+        clearInterval(iv);
+        location.assign("/"); // sauberer Neustart -> Auto-Start greift wieder
+      }
+    }, 1000);
+  };
+
+  // ── Live-Poll ──
+  setInterval(() => {
+    try {
+      const gv: any = (window as any).__GV__;
+      if (!gv) return;
+      tickV.textContent = String(gv.ticks ? gv.ticks() : 0);
+
+      const all: any[] = (gv.players ? gv.players() : []).filter(
+        (p: any) => p.isPlayer && p.isPlayer(),
+      );
+      const me = gv.myPlayer ? gv.myPlayer() : null;
+      const meID = me ? me.smallID() : -1;
+      const inSpawn = gv.inSpawnPhase ? gv.inSpawnPhase() : false;
+      if (me && me.isAlive()) seenAlive = true;
+      // Nur der Host startet ein neues Spiel; Viewer folgen ueber das Relay
+      // (RelayServer laedt bei "reset" neu). Sonst wuerden Viewer unabhaengig
+      // neustarten und desynchronisieren.
+      const isViewer = (window as any).__RELAY_ROLE__ === "viewer";
+      if (!isViewer && seenAlive && !inSpawn && !restarting) {
+        const aliveCount = all.filter((p) => p.isAlive()).length;
+        if (!me || !me.isAlive()) scheduleRestart("eliminated");
+        else if (aliveCount <= 1) scheduleRestart("victory");
+      }
+
+      // Sortiert nach Kacheln (lebend zuerst, dann Groesse).
+      all.sort((a, b) => {
+        const av = a.isAlive() ? 1 : 0;
+        const bv = b.isAlive() ? 1 : 0;
+        if (av !== bv) return bv - av;
+        return b.numTilesOwned() - a.numTilesOwned();
+      });
+      const maxTiles = Math.max(1, ...all.map((p) => p.numTilesOwned()));
+      const myRank = all.findIndex((p) => p.smallID() === meID) + 1;
+
+      // Leaderboard (Top 8 + Modell falls darunter).
+      const shown = all.slice(0, 8);
+      if (me && myRank > 8) shown.push(me);
+      boardBody.replaceChildren();
+      shown.forEach((p, i) => {
+        const rank = all.findIndex((q) => q.smallID() === p.smallID()) + 1;
+        const isMe = p.smallID() === meID;
+        const row = el("div", "row" + (isMe ? " me" : "") + (p.isAlive() ? "" : " dead"));
+        const bar = el("div", "bar");
+        bar.style.width = ((p.numTilesOwned() / maxTiles) * 100).toFixed(1) + "%";
+        row.appendChild(bar);
+        row.appendChild(el("div", "rk", rank === 1 ? "★" : String(rank)));
+        row.appendChild(el("div", "nm", p.displayName ? p.displayName() : p.name()));
+        row.appendChild(el("div", "tl", compact(p.numTilesOwned())));
+        boardBody.appendChild(row);
+      });
+
+      // Modell-Panel (Status-Zeile nicht anfassen, wenn ein Restart laeuft).
+      if (me && me.isAlive()) {
+        if (!restarting) {
+          status.className = "status alive";
+          status.textContent = inSpawn ? "◌ Deploying" : "● Engaged";
+        }
+        stats["Territory"].textContent = compact(me.numTilesOwned()) + " tiles";
+        stats["Gold"].textContent = compact(Number(me.gold()));
+        stats["Troops"].textContent = compact(me.troops());
+        stats["Rank"].textContent = "#" + myRank + " / " + all.length;
+      } else if (!restarting) {
+        if (seenAlive) {
+          status.className = "status dead";
+          status.textContent = "✖ Eliminated";
+        } else {
+          status.className = "status alive";
+          status.textContent = "◌ Connecting…";
+        }
+        stats["Rank"].textContent = "—";
+      }
+    } catch {
+      /* HUD-Fehler duerfen nie stoeren */
+    }
+  }, 250);
+}
