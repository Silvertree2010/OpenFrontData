+.ai-panel {
+  position: absolute; background: linear-gradient(160deg, rgba(6,12,20,.86), rgba(6,12,20,.62));
+  border: 1px solid rgba(34,227,255,.28); border-radius: 10px; padding: 10px 12px;
+  backdrop-filter: blur(3px); box-shadow: 0 6px 26px rgba(0,0,0,.45), inset 0 0 24px rgba(34,227,255,.05);
+}
+.ai-panel .ph { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--cy);
+  opacity: .85; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
+.ai-panel .ph::before { content: ""; width: 5px; height: 5px; background: var(--cy);
+  box-shadow: 0 0 6px var(--cy); border-radius: 50%; }
