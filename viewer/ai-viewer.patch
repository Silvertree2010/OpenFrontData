+}
+
+// NICHT blockierend: startet die Inference im Hintergrund, legt das Ergebnis in
+// _pendingIntent; der naechste Turn haengt es an. So haengt der Tick-Loop nie am Netz.
+function augmentTurn(gr: GameRunner, turn: any): void {
