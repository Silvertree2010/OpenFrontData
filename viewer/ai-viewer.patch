 const ctx: Worker = self as any;
+
+// ── Modell-Autopilot: treibt den Human-Spieler per BC-Modell (Inference-Server) ──
+// Die Adresse stand hier frueher fest. Fuer den Vierfenster-Viewer muss sie je Fenster
