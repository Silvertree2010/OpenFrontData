+// Vollstaendig custom Spectator-UI fuer den "Automated AI Game"-Watch-Client.
+// - blendet die komplette Standard-OpenFront-HUD aus (nur im Spiel: body.in-game)
+// - zeichnet ein eigenes Sci-Fi-Overlay: Banner, Live-Leaderboard, Modell-Stats,
+//   Tick/Frame, dekorativer Rahmen
+// - liest den Live-Spielzustand aus (window.__GV__ = GameView, in GameRenderer gesetzt)
+//
+// Reines Zuschauen: pointer-events der HUD sind aus, manuelles Pan/Zoom laeuft
+// weiter durch das Input-Overlay. Spiel-Intents sind separat via Transport
+// (__SPECTATOR__ -> sendIntent no-op) unterbunden.
+
+// Standard-HUD-Elemente, die im Spiel verborgen werden (scoped auf body.in-game).
+const HIDE_TAGS = [
+  "control-panel", "build-menu", "events-display", "actionable-events",
+  "attacks-display", "chat-display", "chat-modal", "player-info-overlay",
+  "player-panel", "player-profile-modal", "player-moderation-modal",
+  "win-modal", "new-lobby-prompt", "replay-panel", "game-right-sidebar",
+  "game-left-sidebar", "settings-modal", "graphics-settings-modal",
+  "unit-display", "multi-tab-modal", "heads-up-message", "performance-overlay",
+  "alert-frame", "spawn-timer", "immunity-timer", "in-game-promo",
+  "emoji-table", "leaderboard-modal", "team-stats", "send-resource-modal",
+  "help-modal", "desktop-nav-bar", "mobile-nav-bar", "featured-stream",
+];
+
+const CSS = `
+body.in-game ${HIDE_TAGS.join(", body.in-game ")},
+body.in-game .radial-menu-container,
+body.in-game .radial-tooltip { display: none !important; }
+
+#ai-hud, #ai-hud * { box-sizing: border-box; }
+#ai-hud {
+  position: fixed; inset: 0; z-index: 2147483000; pointer-events: none;
+  font-family: "SF Mono", ui-monospace, "Roboto Mono", Menlo, monospace;
+  color: #dff6ff; --cy: #22e3ff; --dim: rgba(154,196,214,.6);
+}
+/* dekorativer Rahmen + Vignette */
+#ai-hud .frame {
+  position: absolute; inset: 0;
