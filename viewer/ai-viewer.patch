+`;
+
+function compact(n: number): string {
+  const a = Math.abs(n);
+  if (a >= 1e9) return (n / 1e9).toFixed(1) + "B";
+  if (a >= 1e6) return (n / 1e6).toFixed(1) + "M";
+  if (a >= 1e3) return (n / 1e3).toFixed(1) + "k";
+  return String(Math.round(n));
+}
+
+function el(tag: string, cls?: string, text?: string): HTMLElement {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text !== undefined) e.textContent = text;
+  return e;
+}
+
+export function installSpectatorUI(): void {
+  if (document.getElementById("ai-hud")) return;
+
+  const style = document.createElement("style");
+  style.textContent = CSS;
+  document.head.appendChild(style);
+
+  const hud = el("div");
+  hud.id = "ai-hud";
+
+  const frame = el("div", "frame");
+  for (const c of ["tl", "tr", "bl", "br"]) frame.appendChild(el("div", "corner " + c));
+  hud.appendChild(frame);
+
+  // Banner
+  const banner = el("div");
+  banner.id = "ai-banner";
+  banner.appendChild(el("span", "dot"));
+  banner.appendChild(el("span", undefined, "🤖 Automated AI Game"));
+  banner.appendChild(el("span", "sub", "· Spectate only · BC model live"));
+  hud.appendChild(banner);
+
+  // Tick
+  const tick = el("div", "ai-panel");
+  tick.id = "ai-tick";
+  const tickV = el("span", "v", "0");
+  tick.append("TICK ", tickV);
+  hud.appendChild(tick);
+
+  // Leaderboard
+  const board = el("div", "ai-panel");
+  board.id = "ai-board";
+  board.appendChild(el("div", "ph", "Live Standings"));
+  const boardBody = el("div");
+  board.appendChild(boardBody);
+  hud.appendChild(board);
+
+  // Model stats
+  const model = el("div", "ai-panel");
+  model.id = "ai-model";
+  model.appendChild(el("div", "ph", "The Model"));
+  const status = el("div", "status", "◌ Standby");
+  model.appendChild(status);
+  const stats: Record<string, HTMLElement> = {};
+  for (const k of ["Territory", "Gold", "Troops", "Rank"]) {
+    const row = el("div", "stat");
+    row.appendChild(el("span", "k", k));
+    const v = el("span", "v", "–");
+    row.appendChild(v);
+    stats[k] = v;
+    model.appendChild(row);
+  }
+  hud.appendChild(model);
+
+  document.body.appendChild(hud);
+
+  // Auto-Restart: sobald das Modell (nach dem Spawn) stirbt oder das Spiel
+  // entschieden ist, kurze Gnadenfrist -> frisches Spiel laden.
+  let seenAlive = false;
+  let restarting = false;
+  const scheduleRestart = (reason: string) => {
+    if (restarting) return;
+    restarting = true;
+    status.className = "status dead";
+    let n = 5;
+    status.textContent = `↻ ${reason} · new game in ${n}s`;
+    const iv = setInterval(() => {
+      n -= 1;
+      status.textContent = `↻ ${reason} · new game in ${n}s`;
+      if (n <= 0) {
+        clearInterval(iv);
+        location.assign("/"); // sauberer Neustart -> Auto-Start greift wieder
+      }
+    }, 1000);
+  };
+
+  // ── Live-Poll ──
+  setInterval(() => {
+    try {
+      const gv: any = (window as any).__GV__;
+      if (!gv) return;
+      tickV.textContent = String(gv.ticks ? gv.ticks() : 0);
+
+      const all: any[] = (gv.players ? gv.players() : []).filter(
+        (p: any) => p.isPlayer && p.isPlayer(),
+      );
+      const me = gv.myPlayer ? gv.myPlayer() : null;
+      const meID = me ? me.smallID() : -1;
+      const inSpawn = gv.inSpawnPhase ? gv.inSpawnPhase() : false;
+      if (me && me.isAlive()) seenAlive = true;
+      // Nur der Host startet ein neues Spiel; Viewer folgen ueber das Relay
+      // (RelayServer laedt bei "reset" neu). Sonst wuerden Viewer unabhaengig
+      // neustarten und desynchronisieren.
+      const isViewer = (window as any).__RELAY_ROLE__ === "viewer";
+      if (!isViewer && seenAlive && !inSpawn && !restarting) {
+        const aliveCount = all.filter((p) => p.isAlive()).length;
+        if (!me || !me.isAlive()) scheduleRestart("eliminated");
+        else if (aliveCount <= 1) scheduleRestart("victory");
+      }
+
+      // Sortiert nach Kacheln (lebend zuerst, dann Groesse).
+      all.sort((a, b) => {
+        const av = a.isAlive() ? 1 : 0;
+        const bv = b.isAlive() ? 1 : 0;
+        if (av !== bv) return bv - av;
+        return b.numTilesOwned() - a.numTilesOwned();
+      });
+      const maxTiles = Math.max(1, ...all.map((p) => p.numTilesOwned()));
+      const myRank = all.findIndex((p) => p.smallID() === meID) + 1;
+
+      // Leaderboard (Top 8 + Modell falls darunter).
+      const shown = all.slice(0, 8);
+      if (me && myRank > 8) shown.push(me);
+      boardBody.replaceChildren();
+      shown.forEach((p, i) => {
+        const rank = all.findIndex((q) => q.smallID() === p.smallID()) + 1;
+        const isMe = p.smallID() === meID;
+        const row = el("div", "row" + (isMe ? " me" : "") + (p.isAlive() ? "" : " dead"));
+        const bar = el("div", "bar");
+        bar.style.width = ((p.numTilesOwned() / maxTiles) * 100).toFixed(1) + "%";
+        row.appendChild(bar);
+        row.appendChild(el("div", "rk", rank === 1 ? "★" : String(rank)));
+        row.appendChild(el("div", "nm", p.displayName ? p.displayName() : p.name()));
+        row.appendChild(el("div", "tl", compact(p.numTilesOwned())));
+        boardBody.appendChild(row);
+      });
+
+      // Modell-Panel (Status-Zeile nicht anfassen, wenn ein Restart laeuft).
+      if (me && me.isAlive()) {
+        if (!restarting) {
+          status.className = "status alive";
+          status.textContent = inSpawn ? "◌ Deploying" : "● Engaged";
+        }
+        stats["Territory"].textContent = compact(me.numTilesOwned()) + " tiles";
+        stats["Gold"].textContent = compact(Number(me.gold()));
+        stats["Troops"].textContent = compact(me.troops());
+        stats["Rank"].textContent = "#" + myRank + " / " + all.length;
+      } else if (!restarting) {
+        if (seenAlive) {
+          status.className = "status dead";
+          status.textContent = "✖ Eliminated";
+        } else {
+          status.className = "status alive";
+          status.textContent = "◌ Connecting…";
+        }
+        stats["Rank"].textContent = "—";
+      }
+    } catch {
+      /* HUD-Fehler duerfen nie stoeren */
+    }
+  }, 250);
+}
