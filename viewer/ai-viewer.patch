+#ai-board .row .tl { color: #bfe9f6; font-variant-numeric: tabular-nums; z-index: 1; }
+#ai-board .row .bar { position: absolute; left: 28px; right: 0; bottom: 1px; height: 100%;
+  background: rgba(34,227,255,.07); border-radius: 3px; z-index: 0; }
+#ai-board .row.me .nm, #ai-board .row.me .tl { color: #eafcff; font-weight: 700; }
+#ai-board .row.me { text-shadow: 0 0 8px rgba(34,227,255,.5); }
+#ai-board .row.me .bar { background: rgba(34,227,255,.20); box-shadow: inset 0 0 0 1px rgba(34,227,255,.4); }
+#ai-board .row.dead .nm, #ai-board .row.dead .tl { color: rgba(154,196,214,.35); }
+
+#ai-model { right: 14px; bottom: 20px; width: 210px; }
+#ai-model .status { font-size: 13px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 10px; }
+#ai-model .status.alive { color: var(--cy); text-shadow: 0 0 10px rgba(34,227,255,.55); }
+#ai-model .status.dead { color: #ff6b6b; text-shadow: 0 0 10px rgba(255,107,107,.5); }
+#ai-model .stat { display: flex; justify-content: space-between; font-size: 12px; padding: 3px 0; }
+#ai-model .stat .k { color: var(--dim); letter-spacing: 1px; }
+#ai-model .stat .v { color: #eafcff; font-variant-numeric: tabular-nums; font-weight: 600; }
